<% provide(:title, "Manage Pinned Actions") %>

<div class="pinned-actions-page index-page">
  <header class="index-header">
    <div>
      <h1>Manage Pinned Actions</h1>
      <p>Keep up to five reusable workflows in the sidebar and on your dashboard.</p>
    </div>
    <%= link_to "Back to Dashboard", dashboard_path, class: "button secondary index-header-action" %>
  </header>

  <section class="pinned-actions-section" aria-labelledby="current-pins-heading">
    <div class="pinned-actions-heading">
      <div>
        <h2 id="current-pins-heading">Your Pins</h2>
        <p><%= @pinned_actions.size %> of <%= UserPinnedAction::MAX_PER_USER %> pinned</p>
      </div>
    </div>

    <% if @pinned_actions.any? %>
      <p class="pinned-actions-hint" id="pinned-actions-hint">
        <%= icon("list") %>
        Drag <span class="show-for-sr">the handle</span> to reorder, or use the move buttons.
      </p>
      <div data-controller="pinned-actions" data-pinned-actions-url-value="<%= reorder_pinned_actions_path %>">
      <ol class="pinned-actions-list" data-pinned-actions-target="list" aria-describedby="pinned-actions-hint">
        <% @pinned_actions.each_with_index do |pin, index| %>
          <% action = PinnedActionRegistry.entries_for([pin], user: current_user, context: self).first %>
          <% next unless action %>
          <li data-pin-id="<%= pin.id %>">
            <span class="drag-handle" title="Drag to reorder">
              <%= icon("list") %>
              <span class="show-for-sr">Drag to reorder</span>
            </span>
            <%= icon(action.icon, class: "pinned-action-icon") %>
            <div class="pinned-action-copy">
              <strong><%= action.label %></strong>
              <span><%= action.description %></span>
            </div>
            <div class="pinned-action-controls">
              <button type="button" class="pinned-action-move" data-action="click->pinned-actions#moveUp"
                      title="Move <%= action.label %> up" <%= "disabled" if index.zero? %>>
                <%= icon("arrow-up") %>
                <span class="show-for-sr">Move up</span>
              </button>
              <button type="button" class="pinned-action-move" data-action="click->pinned-actions#moveDown"
                      title="Move <%= action.label %> down" <%= "disabled" if index == @pinned_actions.size - 1 %>>
                <%= icon("chevron-down") %>
                <span class="show-for-sr">Move down</span>
              </button>
              <%= button_to pinned_action_path(pin), method: :delete,
                            class: "pinned-action-remove",
                            title: "Remove #{action.label}" do %>
                <%= icon("x") %>
                <span>Remove</span>
              <% end %>
            </div>
          </li>
        <% end %>
      </ol>
      <p class="pinned-actions-status" data-pinned-actions-target="status" role="status" aria-live="polite"></p>
      </div>
    <% else %>
      <div class="pinned-actions-empty">
        <%= icon("bookmark") %>
        <div>
          <strong>No pinned actions yet</strong>
          <p>Pin frequently used actions to keep them close at hand.</p>
        </div>
      </div>
    <% end %>
  </section>

  <section class="pinned-actions-section" aria-labelledby="available-actions-heading">
    <div class="pinned-actions-heading">
      <div>
        <h2 id="available-actions-heading">Available Actions</h2>
        <p>Only safe, reusable destinations you can access are shown.</p>
      </div>
    </div>

    <div class="available-actions-list">
      <% @available_actions.each do |action| %>
        <% pin = pinned_action_record(action.key) %>
        <div class="available-action-row">
          <%= icon(action.icon, class: "pinned-action-icon") %>
          <div class="pinned-action-copy">
            <strong><%= action.label %></strong>
            <span><%= action.description %></span>
          </div>
          <% if pin %>
            <span class="pinned-state"><%= icon("check") %> Pinned</span>
          <% elsif @pinned_actions.size >= UserPinnedAction::MAX_PER_USER %>
            <span class="pinned-state pinned-state--limit">Limit reached &mdash; remove a pin to add this</span>
          <% else %>
            <%= button_to "Pin action", pinned_actions_path,
                          params: { action_key: action.key },
                          class: "button tiny secondary" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
</div>
