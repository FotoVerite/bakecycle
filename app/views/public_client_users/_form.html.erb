<%= simple_form_for @user, html: { class: "form-stack" } do |f| %>

  <%= render partial: "shared/error_messages", locals: {f: f} %>

  <fieldset class="form-section">
    <legend>User Information</legend>
    <div class="form-grid">
      <div class="form-field form-span-6">
        <%= f.input :first_name, as: :string, required: true %>
      </div>
       <div class="form-field form-span-6">
        <%= f.input :last_name, as: :string, required: true %>
      </div>

      <div class="form-field form-span-6">
        <%= f.input :email, as: :email, required: true %>
      </div>
      <div class="form-field form-span-6">
        <%= f.input :email_confirmation, as: :email, required: true %>
      </div>

      <div class="form-field form-span-6">
        <% if current_user.admin? %>
          <%= f.input(
            :client_id,
            collection: Bakery.find(1).clients,
            label_method: :name,
            value_method: :id,
            include_blank: 'None',
            as: :select
          ) %>
        <% end %>
      </div>
    </div>
  </fieldset>

  <div class="form-actions">
    <%= f.submit (@user.new_record? ? "Create" : "Update"), class: "button", name: nil %>
    <% unless @user.new_record? %>
      <%= link_to 'Delete', user_path(@user), class: "button alert",
                                method: :delete, data: { confirm: 'Are you sure?' } %>
    <% end %>
  </div>
<% end %>
