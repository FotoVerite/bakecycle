<div class="row ingredient"
     data-ingredient-id="<%= ingredient.id %>"
     data-ingredient-filter-target="row"
     data-controller="ingredient-row"
     data-action="change->ingredient-row#change input->ingredient-row#change">
  <div class="small-12 columns">
    <span class="costing-ingredient-name">
      <h3><%= ingredient.name %></h3>
    </span>
    <input type="hidden" value="false" name="bakery[ingredients_attributes][<%= ingredient.id %>][dirty]"
           data-ingredient-row-target="dirty" />
    <input type="hidden" value="<%= ingredient.id %>" name="bakery[ingredients_attributes][<%= ingredient.id %>][id]" />

    <div class="ingredient-vendor-selection">
      <label class="hide-for-large-up">Vendor</label>
      <select name="bakery[ingredients_attributes][<%= ingredient.id %>][vendor_id]">
        <option value="">--None--</option>
        <% vendors.each do |vendor| %>
          <option value="<%= vendor.id %>" <%= 'selected' if vendor.id == ingredient.vendor_id %>><%= vendor.name %></option>
        <% end %>
      </select>
    </div>

    <div class="ingredient-cost-input">
      <label class="hide-for-large-up">Cost Per Unit</label>
      <input type="number" step="0.01" autocomplete="off"
             name="bakery[ingredients_attributes][<%= ingredient.id %>][cost]"
             data-ingredient-row-target="cost" />
    </div>

    <div class="ingredient-weight-units">
      <label class="hide-for-large-up"><%= ingredient.weight_unit == 'grams' ? '' : "#{ingredient.weight_unit} to grams" %></label>
      <input type="text" disabled
             value="<%= (ingredient.current_amount.to_f * ingredient.conversion.to_f).round %>"
             data-ingredient-row-target="conversionToGrams" />
    </div>

    <div class="ingredient-current-amount-grams">
      <select name="bakery[ingredients_attributes][<%= ingredient.id %>][weight_unit]">
        <% Ingredient::WEIGHT_UNITS.each do |unit| %>
          <option value="<%= unit %>" <%= 'selected' if unit == (ingredient.weight_unit || 'grams') %>><%= unit %></option>
        <% end %>
      </select>
      <input type="number" step="0.01" autocomplete="off"
             value="<%= ingredient.current_amount %>"
             name="bakery[ingredients_attributes][<%= ingredient.id %>][current_amount]"
             data-ingredient-row-target="currentAmount" />
    </div>

    <div class="ingredient-conversion">
      <label class="hide-for-large-up">Conversion</label>
      <input type="number" step="0.01" autocomplete="off"
             value="<%= ingredient.conversion %>"
             name="bakery[ingredients_attributes][<%= ingredient.id %>][conversion]"
             data-ingredient-row-target="conversion" />
    </div>

    <div class="ingredient-current-cost-per-gram">
      <label class="hide-for-large-up">Current Cost Per Gram</label>
      <input type="text" disabled
             value="<%= ingredient.cost_per_gram.to_f %>"
             data-ingredient-row-target="costPerGram" />
    </div>
  </div>
</div>
