<%= content_for :head do %>
  <script src="https://cdn.plot.ly/plotly-latest.min.js"></script>
<% end %>

<% @ingredients.each do | i| %>
  <h2><%= i.name %></h2>
  <div id="ingredient-<%= i.id %>"></div>
  <%= form_for i.todays_buy_order || i.buy_orders.build do |f| %>
  <fieldset class="large-6 cell">
    <legend>Choose Buying Option for Today</legend>
    <% over_time =  i.ingredient_prices_over_time.last_two_weeks %>
    <% over_time.all.group_by(&:vendor_id).each_with_index do |vendor, index| %>
      <input type="radio" name="ingredient-<%= i.id %>-price" value="<%= vendor[1].first.cost_per_unit %>" id="ingredient-<%= i.id %>-priceonRed">
      <label for="pokemonRed"><%= vendor[1].first.vendor.name %>: $<%= vendor[1].first.cost_per_unit %></label>
    <% end %>
  </fieldset>
  <% end %>
<% end %>

<%= content_for :js do %>
 <script>
  var array = []
  <% @ingredients.each do |i| %>
    <% over_time =  i.ingredient_prices_over_time.last_two_weeks %>
    array = []
    <% over_time.all.group_by(&:vendor_id).each_with_index do |vendor, index| %>
    <%= Rails.logger.error vendor[1] %>
      array.push({
        type: "scatter",
        mode: "lines",
        x: <%= raw vendor[1].map(&:created_at).map {|d| d.to_date}.to_json %>,
        y: <%= raw vendor[1].map(&:cost_per_unit).to_json %>,
        name: <%= raw vendor[1].first.vendor.name.to_json %>
      })
    <% end %>


    Plotly.newPlot(
      document.getElementById('ingredient-<%= i.id %>'), 
      array, 
      {
        title: 'Price Per Unit',
        yaxis: {
          tickformat: ',',
          tickprefix: '$',
          type: 'currency'
        },
        xaxis: {
          range: ['<%= Date.today - 2.weeks %>', '<%= Date.today %>'],
          type: 'date'
        }
      },  
      {displaylogo: false}
    );
  <% end %>
 </script>
<% end %>