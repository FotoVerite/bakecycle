<h1>Reports</h1>
<div class="dashboard">

  <div class="row">
    <div class="small-12 columns">
      <h2>Product Runs</h2>
    </div>
    <%= link_to weekly_daily_production_report_production_runs_path do %>
      <div class="large-4 medium-6 small-12 columns">
        <div class="stats border">
          <div class="left">
            Daily/Weekly Totals
          </div>
          <i class="fi-shopping-bag right"></i>
          <div class="clearfix"></div>
        </div>
      </div>
    <% end %>
    <%= link_to date_span_production_report_production_runs_path do %>
      <div class="large-4 medium-6 small-12 columns">
        <div class="stats border">
          <div class="left">
            Date Range Total
          </div>
          <i class="fi-shopping-bag right"></i>
          <div class="clearfix"></div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="row">
    <div class="small-12 columns">
      <h2>Clients</h2>
    </div>
    <%= link_to weekly_daily_report_clients_path do %>
      <div class="large-4 medium-6 small-12 columns">
        <div class="stats border">
          <div class="left">
            Daily/Weekly Totals
          </div>
          <i class="fi-shopping-bag right"></i>
          <div class="clearfix"></div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="row">
    <div class="small-12 columns">
      <h2>Products</h2>
    </div>
    <%= link_to weekly_daily_report_products_path do %>
      <div class="large-4 medium-6 small-12 columns">
        <div class="stats border">
          <div class="left">
            Daily/Weekly Totals
          </div>
          <i class="fi-shopping-bag right"></i>
          <div class="clearfix"></div>
        </div>
      </div>
    <% end %>
    <%= link_to print_pricing_vendors_path, target: "_blank" do %>
      <div class="large-4 medium-6 small-12 columns">
        <div class="stats border">
          <div class="left">
            Pricing
          </div>
          <i class="fi-shopping-bag right"></i>
          <div class="clearfix"></div>
        </div>
      </div>
    <% end %>
  </div>
</div>
