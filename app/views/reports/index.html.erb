<div class="index-page">
  <div class="index-header">
    <div>
      <h1>Reports</h1>
      <p>Open production, client, product, and shipment reporting tools.</p>
    </div>
    <div class="index-header-actions">
      <%= render "shared/pin_action_menu", action_key: "reports" %>
    </div>
  </div>

  <div class="dashboard">
    <div class="row">
      <div class="small-12 columns">
        <h2>Product Runs</h2>
      </div>
      <div class="large-4 medium-6 small-12 columns">
        <%= link_to weekly_daily_production_report_production_runs_path, class: "stats border" do %>
          <div class="left">
            <span class="report-card-title">Daily/Weekly Totals</span>
            <span class="report-card-copy">Production totals by day or week for a selected date.</span>
          </div>
          <%= icon("chart-bar", class: "right") %>
        <% end %>
      </div>
      <div class="large-4 medium-6 small-12 columns">
        <%= link_to date_span_production_report_production_runs_path, class: "stats border" do %>
          <div class="left">
            <span class="report-card-title">Date Range Total</span>
            <span class="report-card-copy">Production totals across a start and end date.</span>
          </div>
          <%= icon("calendar-days", class: "right") %>
        <% end %>
      </div>
      <div class="large-4 medium-6 small-12 columns">
        <%= link_to grocery_list_orders_path, class: "stats border" do %>
          <div class="left">
            <span class="report-card-title">Grocery List</span>
            <span class="report-card-copy">Ingredients needed for projected orders on one date.</span>
          </div>
          <%= icon("shopping-cart", class: "right") %>
        <% end %>
      </div>
    </div>
    <div class="row">
      <div class="small-12 columns">
        <h2>Clients</h2>
      </div>
      <div class="large-4 medium-6 small-12 columns">
        <%= link_to weekly_daily_report_clients_path, class: "stats border" do %>
          <div class="left">
            <span class="report-card-title">Daily/Weekly Totals</span>
            <span class="report-card-copy">Client order totals by day or week for a selected date.</span>
          </div>
          <%= icon("users", class: "right") %>
        <% end %>
      </div>
      <div class="large-4 medium-6 small-12 columns">
        <%= link_to print_vip_list_clients_path, target: "_blank", class: "stats border" do %>
          <div class="left">
            <span class="report-card-title">VIP List</span>
            <span class="report-card-copy">Current VIP clients for production and delivery review.</span>
          </div>
          <%= icon("crown", class: "right") %>
        <% end %>
      </div>
      <div class="large-4 medium-6 small-12 columns">
        <%= link_to total_report_clients_path, target: "_blank", class: "stats border" do %>
          <div class="left">
            <span class="report-card-title">Totals</span>
            <span class="report-card-copy">Client totals for a selected date range.</span>
          </div>
          <%= icon("chart-pie", class: "right") %>
        <% end %>
      </div>
    </div>
    <div class="row">
      <div class="small-12 columns">
        <h2>Products</h2>
      </div>
      <div class="large-4 medium-6 small-12 columns">
        <%= link_to weekly_daily_report_products_path, class: "stats border" do %>
          <div class="left">
            <span class="report-card-title">Daily/Weekly Totals</span>
            <span class="report-card-copy">Product totals by day or week for a selected date.</span>
          </div>
          <%= icon("chart-bar", class: "right") %>
        <% end %>
      </div>
      <div class="large-4 medium-6 small-12 columns">
        <%= link_to print_pricing_vendors_path, target: "_blank", class: "stats border" do %>
          <div class="left">
            <span class="report-card-title">Ingredient Pricing</span>
            <span class="report-card-copy">Vendor ingredient prices for purchasing and costing.</span>
          </div>
          <%= icon("tags", class: "right") %>
        <% end %>
      </div>
      <div class="large-4 medium-6 small-12 columns">
        <%= link_to pricing_report_products_path, target: "_blank", class: "stats border" do %>
          <div class="left">
            <span class="report-card-title">Product Pricing</span>
            <span class="report-card-copy">Product prices and variants for customer billing checks.</span>
          </div>
          <%= icon("tag", class: "right") %>
        <% end %>
      </div>
      <div class="large-4 medium-6 small-12 columns">
        <%= link_to products_per_client_per_week_products_path, class: "stats border" do %>
          <div class="left">
            <span class="report-card-title">Clients Per Product</span>
            <span class="report-card-copy">Which clients receive each product during the week.</span>
          </div>
          <%= icon("users", class: "right") %>
        <% end %>
      </div>
    </div>
    <div class="row">
      <div class="small-12 columns">
        <h2>Shipments</h2>
      </div>
      <div class="large-4 medium-6 small-12 columns">
        <%= link_to nightly_sign_off_path, class: "stats border" do %>
          <div class="left">
            <span class="report-card-title">Nightly Sign Off</span>
            <span class="report-card-copy">Packing and delivery checklist for next-day shipments.</span>
          </div>
          <%= icon("clipboard-list", class: "right") %>
        <% end %>
      </div>
      <div class="large-4 medium-6 small-12 columns">
        <%= link_to detailed_invoice_report_shipments_path, class: "stats border" do %>
          <div class="left">
            <span class="report-card-title">Detailed Invoice Report</span>
            <span class="report-card-copy">Invoice line detail across a selected date range.</span>
          </div>
          <%= icon("file-search", class: "right") %>
        <% end %>
      </div>
      <div class="large-4 medium-6 small-12 columns">
        <%= link_to total_sales_report_shipments_path, class: "stats border" do %>
          <div class="left">
            <span class="report-card-title">Total Sales Report</span>
            <span class="report-card-copy">Sales totals by invoice date range for revenue review.</span>
          </div>
          <%= icon("banknote", class: "right") %>
        <% end %>
      </div>
    </div>
  </div>
</div>
