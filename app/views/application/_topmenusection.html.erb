<header class="top-menu-section" data-controller="navigation">
  <div class="top-menu-brand">
    <button class="top-menu-toggle" type="button" data-action="click->navigation#toggleMenu" aria-label="Toggle navigation">
      <%= icon("menu") %>
    </button>
    <%= link_to "Bakecycle", dashboard_path, class: "top-menu-logo" %>
  </div>

  <% if current_user %>
    <div class="top-menu-context">
      <div class="bakery-context">
        <span>Bakery</span>
        <strong><%= current_bakery&.name || "No bakery selected" %></strong>
      </div>

      <div class="top-menu-actions">
        <% if job_workers_offline? %>
          <% if policy(:job).dashboard? %>
            <%= link_to mission_control_jobs.root_path, class: "operations-status warning", title: "Solid Queue workers are offline", aria: { label: "Workers offline" } do %>
              <%= icon("triangle-alert") %>
              <span>Workers offline</span>
            <% end %>
          <% else %>
            <span class="operations-status warning" title="Solid Queue workers are offline" aria-label="Workers offline">
              <%= icon("triangle-alert") %>
              <span>Workers offline</span>
            </span>
          <% end %>
        <% end %>

        <details class="account-menu">
          <summary>
            <span class="account-avatar"><%= current_user.name.first&.upcase %></span>
            <span class="account-identity">
              <strong><%= current_user.name %></strong>
              <small>Account</small>
            </span>
            <span class="account-menu-settings">
              <%= icon("settings", class: "account-menu-settings-icon", label: "Account settings") %>
            </span>
          </summary>
          <div class="account-menu-panel">
            <% if policy(current_user).edit? %>
              <%= link_to my_users_path do %>
                <%= icon("user") %>
                <span>My Account</span>
              <% end %>
            <% end %>
            <% if current_bakery && policy(current_bakery).edit? %>
              <%= link_to my_bakeries_path do %>
                <%= icon("building-2") %>
                <span>Bakery Settings</span>
              <% end %>
            <% end %>
            <% if policy(User).index? %>
              <%= link_to users_path do %>
                <%= icon("users") %>
                <span>Users</span>
              <% end %>
            <% end %>
            <% if policy(Bakery).index? %>
              <%= link_to bakeries_path do %>
                <%= icon("building-2") %>
                <span>Bakeries</span>
              <% end %>
            <% end %>
            <% if policy(:job).dashboard? %>
              <%= link_to mission_control_jobs.root_path do %>
                <%= icon("list-checks") %>
                <span>Jobs</span>
              <% end %>
            <% end %>
            <%= link_to destroy_user_session_path, class: "account-menu-logout", data: { turbo_method: :delete } do %>
              <%= icon("log-out") %>
              <span>Log Out</span>
            <% end %>
          </div>
        </details>
      </div>
    </div>
  <% end %>
</header>
