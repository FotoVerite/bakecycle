<div class="side-column">
  <div class="large-2 medium-12 small-12 columns">
    <nav class="side-navigation js-nav-toggle" data-controller="navigation" aria-label="Primary navigation">
      <div class="nav-primary-links">
        <%= link_to dashboard_path, class: "nav-primary-link #{'active' if active_nav_group?(:dashboard)}" do %>
          <%= image_tag "icons/icon-dashboard.svg", alt: "", class: "nav-icon" %>
          <span>Dashboard</span>
        <% end %>
        <%= link_to reports_path, class: "nav-primary-link #{'active' if active_nav_group?(:reports)}" do %>
          <i class="fi-graph-bar" aria-hidden="true"></i>
          <span>Reports</span>
        <% end %>
      </div>

      <section class="nav-pins" aria-labelledby="nav-pins-heading">
        <div class="nav-section-heading">
          <span id="nav-pins-heading">Pinned</span>
          <%= link_to pinned_actions_path, class: "nav-section-action" do %>
            <i class="fi-widget" aria-hidden="true"></i>
            Manage
          <% end %>
        </div>
        <% if navigation_pinned_actions.any? %>
          <ul>
            <% navigation_pinned_actions.each do |action| %>
              <li>
                <%= link_to action.path do %>
                  <i class="<%= action.icon %>" aria-hidden="true"></i>
                  <span><%= action.label %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p>Pin frequent actions to keep them close.</p>
        <% end %>
      </section>

      <div class="nav-groups">
        <% if policy(Client).index? %>
          <details class="nav-group" <%= "open" if active_nav_group?(:clients, :orders, :shipments) %>>
            <summary data-action="click->navigation#toggleGroup">
              <%= image_tag "icons/icon-client.svg", alt: "", class: "nav-icon" %>
              <span>Clients</span>
              <i class="fi-arrow-down nav-caret" aria-hidden="true"></i>
            </summary>
            <ul>
              <li class="<%= active_nav?(:clients) %>"><%= link_to "Clients", clients_path %></li>
              <li class="<%= active_nav?(:orders) %>"><%= link_to "Orders", orders_path %></li>
              <li class="<%= active_nav?(:shipments) %>"><%= link_to "Invoices", shipments_path %></li>
            </ul>
          </details>
        <% end %>

        <% if current_bakery && policy(ProductionRun).index? %>
          <details class="nav-group" <%= "open" if active_nav_group?(:print_recipes, :batch_recipes, :production_runs, :production_checklists, :daily_totals) %>>
            <summary data-action="click->navigation#toggleGroup">
              <%= image_tag "icons/icon-production.svg", alt: "", class: "nav-icon" %>
              <span>Production</span>
              <i class="fi-arrow-down nav-caret" aria-hidden="true"></i>
            </summary>
            <ul>
              <li class="<%= active_nav?(:print_recipes) %>"><%= link_to "Daily Recipes", print_recipes_path %></li>
              <li class="<%= active_nav?(:batch_recipes) %>"><%= link_to "Batch Recipes", batch_recipes_path %></li>
              <li class="<%= active_nav?(:daily_totals) %>"><%= link_to "Daily Totals", daily_totals_path %></li>
              <li class="<%= active_nav?(:production_runs) %>"><%= link_to "Production Runs", production_runs_path %></li>
              <li class="<%= active_nav?(:production_checklists) %>"><%= link_to "Checklist", production_checklist_path %></li>
            </ul>
          </details>
        <% end %>

        <% if current_bakery && policy(Route).index? %>
          <details class="nav-group" <%= "open" if active_nav_group?(:routes, :delivery_lists, :packing_slips, :nightly_sign_offs) %>>
            <summary data-action="click->navigation#toggleGroup">
              <%= image_tag "icons/icon-shipping.svg", alt: "", class: "nav-icon" %>
              <span>Shipping</span>
              <i class="fi-arrow-down nav-caret" aria-hidden="true"></i>
            </summary>
            <ul>
              <li class="<%= active_nav?(:delivery_lists) %>"><%= link_to "Delivery Lists", delivery_lists_path %></li>
              <li class="<%= active_nav?(:packing_slips) %>"><%= link_to "Packing Slips", packing_slips_path %></li>
              <li class="<%= active_nav?(:nightly_sign_offs) %>"><%= link_to "Nightly Sign Off", nightly_sign_off_path %></li>
              <li class="<%= active_nav?(:routes) %>"><%= link_to "Routes", routes_path %></li>
            </ul>
          </details>
        <% end %>

        <% if current_bakery && policy(Product).index? %>
          <details class="nav-group" <%= "open" if active_nav_group?(:ingredients, :recipes, :products, :vendors, :buy_orders) %>>
            <summary data-action="click->navigation#toggleGroup">
              <%= image_tag "icons/icon-product.svg", alt: "", class: "nav-icon" %>
              <span>Catalog</span>
              <i class="fi-arrow-down nav-caret" aria-hidden="true"></i>
            </summary>
            <ul>
              <li class="<%= active_nav?(:ingredients) %>"><%= link_to "Ingredients", ingredients_path %></li>
              <li class="<%= active_nav?(:recipes) %>"><%= link_to "Recipes", recipes_path %></li>
              <li class="<%= active_nav?(:products) %>"><%= link_to "Products", products_path %></li>
              <li class="<%= active_nav?(:vendors) %>"><%= link_to "Vendors", vendors_path %></li>
              <li class="<%= active_nav?(:buy_orders) %>"><%= link_to "Buy Orders", buy_orders_path %></li>
            </ul>
          </details>
        <% end %>
      </div>
    </nav>
  </div>
</div>
