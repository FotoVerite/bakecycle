<% provide(:title, "Delivery Lists - #{@recipes.date.strftime('%A %b. %e, %Y')}") %>

<div class="report-page">
  <%= render "shared/report_header",
    title: "Delivery Lists",
    date_text: @recipes.date.strftime("%A %b. %e, %Y"),
    status: pluralize(@recipes.shipments.count, "invoice") %>

  <%= render "shared/report_date_toolbar",
    url: delivery_lists_path,
    date: @recipes.date,
    note_label: "Delivery workflow",
    note: "Review routes and export delivery lists for this date." %>

  <% if @recipes.shipments.any? %>
    <div class="report-actions">
      <div>
        <p class="projection">Delivery routes for this date</p>
      </div>
      <div class="report-action-buttons">
        <%= link_to print_delivery_list_path(@recipes.date.strftime("%Y-%m-%d"), format: :pdf, type: :pdf), target: '_blank', class: "button small" do %>
          <%= icon("file-text") %> Print Delivery List
        <% end %>
        <%= link_to print_delivery_list_path(@recipes.date.strftime("%Y-%m-%d"), type: :xlsx), target: '_blank', class: "button small secondary" do %>
          <%= icon("download") %> Export Excel
        <% end %>
        <%= link_to print_sorted_delivery_list_path(@recipes.date.strftime("%Y-%m-%d")), target: '_blank', class: "button small secondary" do %>
          <%= icon("download") %> Export Sorted Excel
        <% end %>
      </div>
    </div>

  <table class="responsive-table report-table">
    <thead>
      <tr>
        <th scope="col">Client</th>
        <th scope="col">Route</th>
        <th scope="col">Departure Time</th>
      </tr>
    </thead>
    <tbody>
      <% @recipes.shipments.each do |shipment| %>
        <tr>
          <th scope="row"><%= shipment.client_name %></th>
          <td data-title="Route Name"><%= shipment.route_name %></td>
          <td data-title="Departure Time"><%= shipment.route_departure_time.strftime("%I:%M%p") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% else %>
    <h2>No delivery list for this date.</h2>
  <% end %>
</div>
