<table class="responsive-table">
  <thead>
    <tr>
      <th scope="col">Name</th>
      <th scope="col">Type</th>
      <% if show_updated_at_whodoneit || show_created_whodoneit %>
        <th scope="col">By</th>
      <% end %>
      <% if policy(Product).manage_permission? %>
        <th scope="col">Actions</th>
      <% end %>
    </tr>
  </thead>

  <tbody>
    <% recipes.each do |recipe| %>
      <tr class="js-clickable-row" href="<%= edit_recipe_path(recipe) %>">
        <th scope="row"><%= link_to recipe.name, edit_recipe_path(recipe) %></th>
        <!--NB: There is no easy way to get the User besides this. Joining would be preferable -->
        <td data-title="Type"><%= recipe.recipe_type %></td>
        <% if show_created_whodoneit %>
          <td data-title="By">
            <% if (first_editor = recipe.versions.first&.whodunnit) %>
              <%= User.find_by(id: first_editor)&.name || "Unknown user" %>
            <% end %>
          </td>
        <% end %>
        <% if show_updated_at_whodoneit %>
          <td data-title="By">
            <% if (last_editor = recipe.versions.last&.whodunnit) %>
             <%= User.find_by(id: last_editor)&.name || "Unknown user" %>
            <% end %>
          </td>
        <% end %>
        <% if policy(recipe).manage_permission? %>
          <td data-title="Action">
            <%= action_icon edit_recipe_path(recipe), icon_name: "pencil", label: "Edit Recipe", variant: "edit" %>
            <%= action_icon papertrail_recipe_path(recipe), icon_name: "history", label: "Papertrail", variant: "document" %>
          </td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
