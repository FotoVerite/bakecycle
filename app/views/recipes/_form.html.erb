<%= simple_form_for @recipe, html: {
  class: "form-stack",
  data: { controller: "recipe-form", action: "submit->recipe-form#submit" }
} do |f| %>

  <%= render partial: "shared/error_messages", locals: { f: f } %>

  <fieldset class="form-section">
    <legend>Recipe Information</legend>

    <div class="form-grid">
      <div class="form-field form-span-12">
        <%= f.input :name, as: :string %>
      </div>

      <div class="form-field form-span-12">
        <%= f.input :note, as: :text %>
      </div>

      <div class="form-field form-span-4">
        <%= f.input :recipe_type,
            collection: Recipe.recipe_types.keys.map { |k| [k.humanize.titleize, k] },
            selected: @recipe.recipe_type,
            prompt: "Select One",
            as: :select,
            input_html: {
              data: {
                recipe_form_target: "recipeType",
                action: "change->recipe-form#typeChanged"
              }
            } %>
      </div>

      <div class="form-field form-span-4">
        <%= f.input :mix_size, as: :decimal, label: "Mix Size" %>
        <p class="help-text">Pre-ferment mix bowls will match motherdough bowls when only included in one motherdough</p>
      </div>

      <div class="form-field form-span-4">
        <%= f.input :mix_size_unit,
            collection: Recipe.mix_size_units.keys.map { |k| [k, k] },
            as: :select,
            include_blank: false %>
      </div>

      <div class="form-field form-span-4"
           data-recipe-form-target="leadDaysField"
           <%= 'hidden' unless @recipe.recipe_type == "dough" %>>
        <%= f.input :lead_days, as: :integer, label: "Lead Days" %>
      </div>
    </div>
  </fieldset>

  <% inclusions = @recipe.recipe_type == "dough" ? @available_inclusions : @available_ingredients %>

  <fieldset class="form-section" data-controller="nested-form">
    <legend>Ingredients</legend>

    <div class="form-grid nested-col-headers recipe-item-grid">
      <div></div>
      <div class="nested-col-label">Ingredient <abbr title="required">*</abbr></div>
      <div class="nested-col-label">Baker's % <abbr title="required">*</abbr></div>
      <div class="nested-col-label">Type</div>
      <div class="nested-col-label">Lead Time</div>
      <div></div>
    </div>

    <div data-nested-form-target="rows" data-recipe-form-target="sortable">
      <% @recipe.recipe_items.where(removed: false).order(:sort_id).includes(:inclusionable).each_with_index do |item, index| %>
        <%= f.fields_for :recipe_items, item, index: index do |ri| %>
          <%= render "recipes/recipe_item_fields", ri: ri, item: item, inclusions: inclusions %>
        <% end %>
      <% end %>
    </div>

    <template data-nested-form-target="template">
      <%= f.fields_for :recipe_items, RecipeItem.new, index: "NEW_RECORD" do |ri| %>
        <%= render "recipes/recipe_item_fields", ri: ri, item: RecipeItem.new, inclusions: inclusions, is_template: true %>
      <% end %>
    </template>

    <button type="button" class="button small nested-add-btn" data-action="nested-form#add">
      + Add Ingredient
    </button>
  </fieldset>

  <div class="form-actions">
    <%= f.submit (@recipe.new_record? ? "Create Recipe" : "Save Changes"), class: "button", name: nil %>
    <% unless @recipe.new_record? %>
      <%= link_to "Delete Recipe", recipe_path(@recipe),
          class: "button alert",
          method: :delete,
          data: { confirm: "Are you sure you want to delete this recipe?" } %>
    <% end %>
    <%= link_to "Back to Recipes", recipes_path, class: "button secondary" %>
  </div>

<% end %>
