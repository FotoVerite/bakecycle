<% provide(:title, "Daily Totals - #{@recipes.date.strftime('%A %b. %e, %Y')}") %>

<div class="report-page">
  <%= render "shared/report_header",
    title: "Daily Totals",
    date_text: @recipes.date.strftime("%A %b. %e, %Y"),
    status: pluralize(@recipes.shipments.count, "invoice") %>

  <%= render "shared/report_date_toolbar",
    url: daily_totals_path,
    date: @recipes.date,
    note_label: "Production totals",
    note: "Print or export daily totals for routes and production planning." %>

  <% if @recipes.routes.any? %>
    <div class="report-actions">
      <div>
        <p class="projection"><%= pluralize(@recipes.shipments.count, "Invoice") %> on the following routes</p>
      </div>
      <div class="report-action-buttons">
        <%= link_to "#{icon('file-text')} Print With Routes".html_safe,
          print_daily_total_path(@recipes.date.strftime("%Y-%m-%d"), show_routes: true, format: :pdf), target: "_blank", class: "button small"%>

        <%= link_to "#{icon('file-text')} Print Without Routes".html_safe,
          print_daily_total_path(@recipes.date.strftime("%Y-%m-%d"), show_routes: false, format: :pdf), target: "_blank", class: "button small secondary"%>

        <%= link_to "#{icon('download')} Export With Routes".html_safe,
          print_daily_total_path(@recipes.date.strftime("%Y-%m-%d"), show_routes: true, format: :xlsx), target: "_blank", class: "button small secondary" %>

        <%= link_to "#{icon('download')} Export Without Routes".html_safe,
          print_daily_total_path(@recipes.date.strftime("%Y-%m-%d"), show_routes: false, format: :xlsx), target: "_blank", class: "button small secondary" %>
      </div>
    </div>
  <table class="responsive-table report-table">
    <thead>
      <tr>
        <th scope="col">Route</th>
        <th scope="col">Departure Time</th>
      </tr>
    </thead>
    <tbody>
      <% @recipes.routes.each do |route| %>
        <tr>
          <th scope="row"><%= route.name %></th>
          <td data-title="Departure Time">
            <%= route.departure_time.strftime("%I:%M%p") %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% else %>
    <h2>No daily totals for this date.</h2>
  <% end %>
</div>
