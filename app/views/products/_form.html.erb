<%= simple_form_for @product, html: { class: "form-stack" } do |f| %>

  <%= render partial: "shared/error_messages", locals: {f: f} %>

  <fieldset class="form-section">
    <legend>Product Information</legend>

    <div class="form-grid">
      <div class="form-field form-span-12">
        <label class="form-check">
          <%= f.input_field :inactive, as: :boolean, input_html: { id: 'inactive' } %>
          <span>Inactive?</span>
        </label>
      </div>

      <div class="form-field form-span-12">
        <%= f.input :name, as: :string %>
      </div>

      <div class="form-field form-span-6">
        <%= f.input :product_type, collection: product.product_types_select, prompt: "Select One", as: :select %>
      </div>
      <div class="form-field form-span-6">
        <%= f.input :sku, as: :string %>
      </div>

      <div class="form-field form-span-6">
        <%= f.input :base_price, as: :decimal %>
      </div>
      <div class="form-field form-span-6">
        <%= f.input :cog, as: :decimal %>
      </div>

      <div class="form-field form-span-6">
        <%= f.input :weight, as: :decimal %>
      </div>
      <div class="form-field form-span-6">
        <%= f.input :unit, collection: product.units_select, as: :select, include_blank: false %>
      </div>

      <div class="form-field form-span-4">
        <%= f.input :over_bake, label: "over bake %", as: :decimal %>
      </div>
      <div class="form-field form-span-4">
        <%= f.label :total_lead_days %>
        <input disabled="true" type="text" value="<%= product.total_lead_days %>" />
      </div>
      <div class="form-field form-span-4">
        <%= f.input :lead_days_override, label: "lead days override", as: :integer%>
      </div>

      <div class="form-field form-span-12">
        <%= f.input :description, as: :text%>
      </div>

      <div class="form-field form-span-6">
        <%= f.input :motherdough_id, collection: product.motherdoughs, label_method: :name, value_method: :id, include_blank: 'Select One', as: :select %>
      </div>
      <div class="form-field form-span-6">
        <%= f.input :inclusion_id, collection: product.inclusions, label_method: :name, value_method: :id,include_blank: 'Select One', as: :select %>
      </div>

      <div class="form-field form-span-12 form-check-list">
        <label class="form-check">
          <%= f.input_field :batch_recipe, as: :boolean, input_html: { id: 'batch_recipe' } %>
          <span>Include Product on batch reports?</span>
        </label>
        <label class="form-check">
          <%= f.input_field :public, as: :boolean, input_html: { id: 'public' } %>
          <span>Display on public site</span>
        </label>
      </div>
    </div>
  </fieldset>

  <fieldset class="form-section" data-controller="nested-form">
    <legend>Prices</legend>

    <div class="form-grid nested-col-headers price-variant-grid">
      <div class="form-span-7 nested-col-label">Client</div>
      <div class="form-span-2 nested-col-label">Min. Quantity <abbr title="required">*</abbr></div>
      <div class="form-span-2 nested-col-label">Price <abbr title="required">*</abbr></div>
      <div class="form-span-1"></div>
    </div>

    <div data-nested-form-target="rows">
      <% sorted_variants = @product.price_variants.sort_by { |pv| [pv.client_id.nil? ? 0 : 1, pv.persisted? ? 0 : 1, pv.client_name, pv.quantity || 0] } %>
      <%= f.simple_fields_for :price_variants, sorted_variants do |pv_form| %>
        <%= render 'price_variant_fields', pv_form: pv_form, clients: @clients %>
      <% end %>
    </div>

    <template data-nested-form-target="template">
      <%= f.fields_for :price_variants, PriceVariant.new, child_index: "NEW_RECORD" do |pv_form| %>
        <%= render 'price_variant_fields', pv_form: pv_form, clients: @clients, is_template: true %>
      <% end %>
    </template>

    <button type="button" class="button small nested-add-btn" data-action="nested-form#add">+ Add Price</button>
  </fieldset>

  <div class="form-actions">
    <%= f.submit (@product.new_record? ? "Create" : "Update"), class: "button", name: nil %>
    <% unless @product.new_record? %>
      <%= link_to 'Delete', product_path(@product), class: "button alert",
                                data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' } %>
    <% end %>
  </div>
<% end %>
