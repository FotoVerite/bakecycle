<%= simple_form_for @product, html: { class: "form-stack" } do |f| %>

  <%= render partial: "shared/error_messages", locals: {f: f} %>

  <fieldset class="form-section">
    <legend>Product Information</legend>

    <div class="form-grid">
      <div class="form-field form-span-12 form-check-list-inline">
        <label class="form-check form-switch-card">
          <%= f.input_field :inactive, as: :boolean, input_html: { id: 'inactive' } %>
          <span>
            <strong>Inactive?</strong>
          </span>
        </label>
      </div>

      <div class="form-field form-span-12">
        <%= f.input :name, as: :string %>
      </div>

      <div class="form-field form-span-6">
        <%= f.input :product_type, collection: product.product_types_select, prompt: "Select One", as: :select %>
      </div>
      <div class="form-field form-span-6">
        <%= f.input :sku, as: :string %>
      </div>

      <div class="form-field form-span-6">
        <%= f.input :base_price, as: :decimal %>
      </div>
      <div class="form-field form-span-6">
        <%= f.input :cog, as: :decimal %>
      </div>

      <div class="form-field form-span-6">
        <%= f.input :weight, as: :decimal %>
      </div>
      <div class="form-field form-span-6">
        <%= f.input :unit, collection: product.units_select, as: :select, include_blank: false %>
      </div>

      <div class="form-field form-span-3">
        <%= f.input :over_bake, label: "over bake %", as: :decimal %>
      </div>
      <div class="form-field form-span-3">
        <%= f.label :total_lead_days %>
        <input disabled="true" type="text" value="<%= product.total_lead_days %>" />
      </div>
      <div class="form-field form-span-3">
        <%= f.input :lead_days_override, label: "lead days override", as: :integer%>
      </div>
      <div class="form-field form-span-3">
        <%= f.input :pieces_per_tray, label: "Pieces per tray", as: :integer %>
      </div>
      <div class="form-field form-span-3">
        <%= f.input :bake_lead_days, label: "Bake lead days", hint: "0 = baked morning of delivery, 1 = baked the day before, blank = pulled from storage", as: :integer %>
      </div>

      <div class="form-field form-span-12">
        <%= f.input :description, as: :text%>
      </div>

      <div class="form-field form-span-6">
        <%= f.input :motherdough_id, collection: product.motherdoughs, label_method: :name, value_method: :id, include_blank: 'Select One', as: :select %>
      </div>
      <div class="form-field form-span-6">
        <%= f.input :inclusion_id, collection: product.inclusions, label_method: :name, value_method: :id,include_blank: 'Select One', as: :select %>
      </div>

      <div class="form-field form-span-12 form-check-list-inline">
        <label class="form-check form-switch-card">
          <%= f.input_field :batch_recipe, as: :boolean, input_html: { id: 'batch_recipe' } %>
          <span>
            <strong>Include Product on batch reports?</strong>
          </span>
        </label>
        <label class="form-check form-switch-card">
          <%= f.input_field :public, as: :boolean, input_html: { id: 'public' } %>
          <span>
            <strong>Display on public site</strong>
          </span>
        </label>
        <label class="form-check form-switch-card">
          <%= f.input_field :on_pull_list, as: :boolean, input_html: { id: 'on_pull_list' } %>
          <span>
            <strong>On pull/prep list</strong>
          </span>
        </label>
        <label class="form-check form-switch-card">
          <%= f.input_field :on_vienn_pick, as: :boolean, input_html: { id: 'on_vienn_pick' } %>
          <span>
            <strong>On Vienn Pick list</strong>
          </span>
        </label>
      </div>
    </div>
  </fieldset>

  <%# Shared once for every client select below (Prices + Bake Lead Time Overrides both
      choose from this same @clients collection) -- rendering the ~300+ options here once
      and letting tom-select read them from this cache, instead of repeating the full
      option list inside every row's <select>, is what keeps a product with dozens of
      per-client overrides from shipping tens of thousands of duplicate <option> nodes. %>
  <script type="application/json" id="product-clients-options">
    <%= raw json_escape(@clients.map { |c| { value: c.id, text: c.name } }.to_json) %>
  </script>

  <fieldset class="form-section" data-controller="nested-form">
    <legend>Prices</legend>

    <% if @product.price_variants.size > 5 %>
      <details class="nested-section-disclosure">
        <summary class="nested-section-summary"><%= pluralize(@product.price_variants.size, "price") %></summary>
        <%= render "price_variant_rows", f: f %>
      </details>
    <% else %>
      <%= render "price_variant_rows", f: f %>
    <% end %>
  </fieldset>

  <fieldset class="form-section" data-controller="nested-form">
    <legend>Bake Lead Time Overrides</legend>

    <% if @product.bake_lead_day_variants.size > 5 %>
      <details class="nested-section-disclosure">
        <summary class="nested-section-summary">
          <%= pluralize(@product.bake_lead_day_variants.size, "override") %>
        </summary>
        <%= render "bake_lead_day_variant_rows", f: f %>
      </details>
    <% else %>
      <%= render "bake_lead_day_variant_rows", f: f %>
    <% end %>
  </fieldset>

  <div class="form-actions">
    <%= f.submit (@product.new_record? ? "Create" : "Update"), class: "button", name: nil %>
    <% unless @product.new_record? %>
      <%= link_to 'Delete', product_path(@product), class: "button alert",
                                data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' } %>
    <% end %>
  </div>
<% end %>
