<% provide(:title, "Viewing Product: #{@product.name}") %>

<div class="form-page">
  <div class="form-header">
    <div>
      <h1>Viewing Product: <%= @product.name %></h1>
      <p>Usage graphs and active orders for this product.</p>
    </div>

    <div class="form-header-actions">
      <%= link_to 'Back', products_path, class: "button small secondary" %>
      <%= link_to 'Edit Product', edit_product_path(@product), class: "button small" %>
    </div>
  </div>

  <h2 id="show-graphs">
    Graphs
    <span class="right graphs-toggle-icons">
      <%= icon("arrow-right", class: "graphs-toggle-icon graphs-toggle-icon--closed") %>
      <%= icon("chevron-down", class: "graphs-toggle-icon graphs-toggle-icon--open", hidden: true) %>
    </span>
  </h2>
  <div id="graphs" style="display: none;" data-graph-data="<%= @product.graph_data ? json_escape(@product.graph_data.to_json) : '' %>">
    <div id="gross-profits"></div><br />
    <div id="shipped"></div><br />
    <div id="shipments"></div>
  </div>

  <hr />

  <h2>Orders</h2>
  <div id='orders'>
    Used in: <%= pluralize(@orders_in_use.count, 'order') %>
    <%= render partial: "orders/order_table", locals: {
      orders: @orders,
      missing_shipment_ids: [],
      show_created_whodoneit: false,
      show_updated_at_whodoneit: false
    }
  %>
  </div>
</div>

<%= content_for :js do %>
 <script>
  (function() {
    var graphsSection = document.getElementById('show-graphs');
    var graphsContainer = document.getElementById('graphs');
    var plotlyLoaded = false;
    var plotlyLoading = false;

    var renderGraphs = function() {
      var rawData = graphsContainer.dataset.graphData;
      if (!rawData) {
        return;
      }
      var graphData = JSON.parse(rawData);

      var PROFITS = document.getElementById('gross-profits');
      var SHIPPED = document.getElementById('shipped');
      var SHIPMENTS = document.getElementById('shipments');

      var profit = {
        type: "scatter",
        mode: "lines",
        x: graphData.dates,
        y: graphData.amounts,
        line: {color: '#17BECF'}
      };
      var layout = {
        title: 'Gross Profit Per Day',
        yaxis: { tickformat: ',', tickprefix: '$', type: 'currency' },
        xaxis: { range: ['<%= Date.today.beginning_of_year %>', '<%= Date.today %>'], type: 'date' }
      };

      var shipped = {
        type: "scatter",
        mode: "lines",
        x: graphData.dates,
        y: graphData.shipped,
        line: {color: '#17BECF'}
      };
      var shippedLayout = {
        title: 'Total Shipped Per Day',
        yaxis: { tickformat: ',' },
        xaxis: { range: ['<%= Date.today.beginning_of_year %>', '<%= Date.today %>'], type: 'date' }
      };

      var shipment = {
        type: "scatter",
        mode: "lines",
        x: graphData.dates,
        y: graphData.shipments_count,
        line: {color: '#17BECF'}
      };
      var shipmentLayout = {
        title: 'Total Shipments Per Day',
        yaxis: { tickformat: ',' },
        xaxis: { range: ['<%= Date.today.beginning_of_year %>', '<%= Date.today %>'], type: 'date' }
      };

      Plotly.newPlot(PROFITS, [profit], layout, {displaylogo: false});
      Plotly.newPlot(SHIPPED, [shipped], shippedLayout, {displaylogo: false});
      Plotly.newPlot(SHIPMENTS, [shipment], shipmentLayout, {displaylogo: false});
    };

    var openGraphs = function() {
      graphsSection.querySelector('.graphs-toggle-icon--closed').toggleAttribute('hidden');
      graphsSection.querySelector('.graphs-toggle-icon--open').toggleAttribute('hidden');

      var isOpening = graphsContainer.style.display === 'none';
      graphsContainer.style.display = isOpening ? 'block' : 'none';

      if (!isOpening) {
        return;
      }

      if (plotlyLoaded) {
        renderGraphs();
        Plotly.Plots.resize(document.getElementById('gross-profits'));
        Plotly.Plots.resize(document.getElementById('shipped'));
        Plotly.Plots.resize(document.getElementById('shipments'));
        return;
      }

      if (plotlyLoading) {
        return;
      }
      plotlyLoading = true;

      var script = document.createElement('script');
      script.src = 'https://cdn.plot.ly/plotly-2.35.2.min.js';
      script.onload = function() {
        plotlyLoaded = true;
        renderGraphs();
      };
      document.head.appendChild(script);
    };

    graphsSection.addEventListener('click', openGraphs);
  })();
 </script>
<% end %>
