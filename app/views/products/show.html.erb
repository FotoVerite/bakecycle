<% provide(:title, "Viewing Product: #{@product.name}") %>

<h1>Viewing Product: <%= @product.name %></h1>

<%= link_to 'Back', products_path, class: "button small" %>
    
  <h2 id="show-graphs">Graphs <i class="fi-arrow-right right"></i></h2> 
  <div id="graphs" style="display: none;">
    <div id="gross-profits"></div><br />
    <div id="shipped"></div><br />
    <div id="shipments"></div>
  </div>

  <hr />
  
  <h2>Orders </h2>
  <div id='orders'>
    Used in: <%= pluralize(@product.orders_in_use.count, 'order') %>
    <%= render partial: "orders/order_table", locals: {
      orders: @product.orders_in_use,
      missing_shipment_ids: [],
      show_created_whodoneit: false,
      show_updated_at_whodoneit: false
    }
  %>
  </div>

<%= content_for :head do %>
  <script src="https://cdn.plot.ly/plotly-latest.min.js"></script>
<% end %>

<%= content_for :js do %>
 <script>
  PROFITS = document.getElementById('gross-profits');
  SHIPPED = document.getElementById('shipped');
  SHIPMENTS = document.getElementById('shipments');

<% if  @product.graph_data %>
var profit = {
  type: "scatter",
  mode: "lines",
  x: <%= raw @product.graph_data['dates'] %>,
  y: <%= raw @product.graph_data['amounts'] %>,
  line: {color: '#17BECF'}
}

var data = [profit];

var layout = {
  title: 'Gross Profit Per Day',
  yaxis: {
    tickformat: ',',
    tickprefix: '$',
    type: 'currency'
  },
  xaxis: {
    range: ['<%= Date.today.beginning_of_year %>', '<%= Date.today %>'],
    type: 'date'
  }
};

var shipped = {
  type: "scatter",
  mode: "lines",
  x: <%= raw @product.graph_data['dates'] %>,
  y: <%= raw @product.graph_data['shipped'] %>,
  line: {color: '#17BECF'}
}

var shipped_data = [shipped];

var shipped_layout = {
  title: 'Total Shipped Per Day',
  yaxis: {
    tickformat: ','
  },
  xaxis: {
    range: ['<%= Date.today.beginning_of_year %>', '<%= Date.today %>'],
    type: 'date'
  }
};



var shipment = {
  type: "scatter",
  mode: "lines",
  x: <%= raw @product.graph_data['dates'] %>,
  y: <%= raw @product.graph_data['shipments_count'] %>,
  line: {color: '#17BECF'}
}

var shipment_data = [shipment];

var shipment_layout = {
  title: 'Total Shipments Per Day',
  yaxis: {
    tickformat: ','
  },
  xaxis: {
    range: ['<%= Date.today.beginning_of_year %>', '<%= Date.today %>'],
    type: 'date'
  }
};

Plotly.newPlot(PROFITS, data, layout,  {displaylogo: false});
Plotly.newPlot(SHIPPED, shipped_data, shipped_layout,  {displaylogo: false});
Plotly.newPlot(SHIPMENTS, shipment_data, shipment_layout,  {displaylogo: false});
<% end %>

  $('#show-graphs').click(function() {
    $i = $(this).find('i');
    if($i.hasClass('fi-arrow-right')) {
      $i.removeClass('fi-arrow-right').addClass('fi-arrow-down')
    }
    else {
      $i.removeClass('fi-arrow-down').addClass('fi-arrow-right')
    }
    $("#graphs").toggle('fast', function(){
      Plotly.Plots.resize(PROFITS);
      Plotly.Plots.resize(SHIPPED);
      Plotly.Plots.resize(SHIPMENTS);
    });


  })
 </script>
<% end %>