<% provide(:title, "Products per Client per Week Report") %>

<div class="report-page report-generator-page">
  <%= render "shared/report_header",
    title: "Products per Client",
    date_text: @date.strftime("%A %b. %e, %Y"),
    status: "Weekly" %>

  <div class="report-toolbar">
    <%= simple_form_for "", url: print_products_per_client_per_week_products_path, method: :get, html: { class: "report-print-form", data: { turbo_stream: true } } do |f| %>
      <div class="report-date-form">
        <%= f.input :date, input_html: { value: @date.strftime("%Y-%m-%d"), class: "js-datepicker", name: :date}, required: false %>
        <%= button_tag "#{icon('download')} Export Report".html_safe, name: "type", value: "daily", class: "button search-button" %>
      </div>
    <% end %>
    <div class="report-toolbar-note">
      <span>Product report</span>
      Exports weekly product quantities grouped by client.
    </div>
  </div>

  <%= link_to "Back to Reports", reports_path, class: "button small secondary report-back-link" %>
</div>
