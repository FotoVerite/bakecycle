<% is_all_clients = pv_form.object.client_id.nil? && !local_assigns.fetch(:is_template, false) %>
<div class="nested-row" data-nested-row>
  <div class="form-grid nested-row-grid price-variant-grid">
    <div class="form-field form-span-7">
      <% if is_all_clients %>
        <div class="pv-all-clients-label">All Clients</div>
        <%= pv_form.hidden_field :client_id, value: '' %>
      <% else %>
        <%= pv_form.select :client_id,
              options_for_select(clients.map { |c| [c.name, c.id] }, pv_form.object.client_id),
              { include_blank: 'Select Client' },
              class: 'nested-field',
              data: { action: 'change->nested-form#syncClientSelects' } %>
      <% end %>
    </div>
    <div class="form-field form-span-2">
      <%= pv_form.number_field :quantity, placeholder: '0', min: 1, step: 1, inputmode: 'numeric', required: true, class: 'nested-field nested-field-quantity' %>
    </div>
    <div class="form-field form-span-2">
      <%= pv_form.number_field :price, placeholder: '0.00', min: 0, step: '0.01', required: true, class: 'nested-field nested-field-price' %>
    </div>
    <div class="form-field form-span-1 nested-row-actions">
      <% unless is_all_clients %>
        <% if pv_form.object.persisted? %>
          <%= pv_form.hidden_field :_destroy, value: '', data: { destroy_field: '' } %>
          <button type="button" class="nested-btn-restore nested-icon-btn button tiny secondary" data-action="nested-form#restore" title="Restore price" aria-label="Restore price" hidden>
            <%= icon("rotate-ccw") %>
          </button>
        <% end %>
        <button type="button" class="nested-btn-remove nested-icon-btn button tiny secondary" data-action="nested-form#remove" title="Remove price" aria-label="Remove price">
          <%= icon("trash-2") %>
        </button>
      <% end %>
    </div>
  </div>
</div>
