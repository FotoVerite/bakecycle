<div class="nested-row" data-nested-row>
  <div class="form-grid nested-row-grid price-variant-grid">
    <div class="form-field form-span-7">
      <%= pv_form.select :client_id,
            options_for_select([['All Clients', '']] + clients.map { |c| [c.name, c.id] }, pv_form.object.client_id),
            {},
            class: 'nested-field',
            data: { action: 'change->nested-form#syncClientSelects' } %>
    </div>
    <div class="form-field form-span-2">
      <%= pv_form.number_field :quantity, placeholder: '0', min: 1, step: 1, inputmode: 'numeric', required: true, class: 'nested-field nested-field-quantity' %>
    </div>
    <div class="form-field form-span-2">
      <%= pv_form.number_field :price, placeholder: '0.00', min: 0, step: '0.01', required: true, class: 'nested-field nested-field-price' %>
    </div>
    <div class="form-field form-span-1 nested-row-actions">
      <% if pv_form.object.persisted? %>
        <%= pv_form.hidden_field :_destroy, value: '', data: { destroy_field: '' } %>
        <button type="button" class="nested-btn-restore button tiny secondary" data-action="nested-form#restore" hidden>Undo</button>
      <% end %>
      <button type="button" class="nested-btn-remove button tiny alert" data-action="nested-form#remove">✕</button>
    </div>
  </div>
</div>
