<div class="replaceable">
  <div class="index-table">
    <table class="responsive-table products-index">
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Product Type</th>
          <th scope="col">Description</th>
          <th scope="col">SKU</th>
          <th scope="col">Active</th>
          <% if policy(Product).manage_permission? %>
            <th scope="col">Action</th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% products.each do |product| %>
          <tr class="js-clickable-row" href="<%= edit_product_path(product) %>">
            <th scope="row"><%= link_to product.name, edit_product_path(product), data: { turbo_frame: "_top" } %></th>
            <td data-title="Product Type"><%= product.type %></td>
            <td data-title="Description"><%= product.truncated_description %></td>
            <td data-title="SKU"><%= product.sku_display %></td>
            <td data-title="Active"><%= product.inactive? ? "No" : "Yes" %></td>
            <% if policy(product).manage_permission? %>
              <td data-title="Action">
                <%= action_icon product_path(product), icon_name: "eye", label: "View Product", variant: "document",
                      link_data: { turbo_frame: "_top" } %>
                <%= action_icon edit_product_path(product), icon_name: "pencil", label: "Edit Product", variant: "edit",
                      link_data: { turbo_frame: "_top" } %>
                <%= action_icon papertrail_product_path(product), icon_name: "history", label: "Papertrail", variant: "document",
                      link_data: { turbo_frame: "_top" } %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= will_paginate products %>
</div>
