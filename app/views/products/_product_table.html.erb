<div class="replaceable">
  <div class="index-table">
    <table class="responsive-table products-index">
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Product Type</th>
          <th scope="col">Description</th>
          <th scope="col">SKU</th>
          <th scope="col">Active</th>
          <% if policy(Product).manage_permission? %>
            <th scope="col">Action</th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% products.each do |product| %>
          <tr class="js-clickable-row" href="<%= edit_product_path(product) %>">
            <th scope="row"><%= link_to product.name, edit_product_path(product) %></th>
            <td data-title="Product Type"><%= product.type %></td>
            <td data-title="Description"><%= product.truncated_description %></td>
            <td data-title="SKU"><%= product.sku_display %></td>
            <td data-title="Active"><%= product.inactive? ? "No" : "Yes" %></td>
            <% if policy(product).manage_permission? %>
              <td data-title="Action">
                <%= link_to product_path(product) do %>
                  <span class="table-action-icon table-action-icon--document icon-link-tooltip" aria-label="View Product"><%= icon("eye") %></span>
                <% end %>
                <%= link_to edit_product_path(product) do %>
                  <span class="table-action-icon table-action-icon--edit icon-link-tooltip" aria-label="Edit Product">
                    <%= icon("pencil") %>
                  </span>
                <% end %>
                <%= link_to papertrail_product_path(product) do %>
                  <span class="table-action-icon table-action-icon--document icon-link-tooltip" aria-label="Papertrail"><%= icon("eye") %></span>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= will_paginate products %>
</div>
