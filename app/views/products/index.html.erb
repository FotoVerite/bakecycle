<% provide(:title, "Products") %>

<h1>Products</h1>

<%= form_tag(products_path, :remote => true, method: :get, class: 'row collapse bakecycle-form') do %>

  <div class="small-12 medium-1 columns">
      <label class="" style="font-weight:bold;color:black;display:inline-block;">Active?</label>
      <%= select_tag :active, options_for_select([['Yes', false],['No', true],['Any', 'any']], params[:active] || false), class: 'js-field' %>
  </div>
  
<% end %>

<% if policy(Product).new? %>
  <p><%= link_to 'Add New Product', new_product_path, class: "button" %></p>
<% end %>



<%= render partial: "product_table", locals: {
    products: @products.decorate,
    show_created_whodoneit: false,
    show_updated_at_whodoneit: false
  }
%>

<%= content_for :js do %>
<script>
  $(document).ready(function() {
   $('body').on('change', '.js-field', function() {
    $(this).parent().parent().submit()
   })
  })
</script>
<% end %>