<% provide(:title, "Products") %>

<div class="index-page">
  <div class="index-header">
    <div>
      <h1>Products</h1>
      <p>Filter, review, and manage product records.</p>
    </div>

    <% if policy(Product).new? %>
      <%= link_to 'Add New Product', new_product_path, class: "button index-header-action" %>
    <% end %>
  </div>

  <%= form_tag(products_path, method: :get, class: 'index-toolbar index-toolbar-compact bakecycle-form', data: { turbo_frame: "products" }) do %>
    <div class="index-filter index-filter-small">
      <label>Active</label>
      <%= select_tag :active, options_for_select([['Yes', false],['No', true],['Any', 'any']], params[:active] || false), class: 'js-field' %>
    </div>
  <% end %>

  <%= turbo_frame_tag "products" do %>
    <%= render partial: "product_table", locals: {
      products: @products.decorate,
      show_created_whodoneit: false,
      show_updated_at_whodoneit: false
    } %>
  <% end %>
</div>

<%= content_for :js do %>
<script>
  document.addEventListener('change', function(event) {
    if (!event.target.matches('.js-field')) return

    var form = event.target.closest('form')
    if (form) form.requestSubmit()
  })
</script>
<% end %>
