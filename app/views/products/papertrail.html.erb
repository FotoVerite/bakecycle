<% provide(:title, "Papertrail of Product #{@product.name} ##{@product.id}") %>
<div class="papertrail-page">
  <div class="index-header">
    <div>
      <h1>Papertrail of <%= @product.name %></h1>
      <p class="papertrail-summary">
        <% if (last_editor = @product.versions.last&.whodunnit) %>
          <span class="account-avatar"><%= (User.find_by(id: last_editor)&.name || "?").first.upcase %></span>
          <span>
            Last edited by <strong><%= User.find_by(id: last_editor)&.name || "Unknown user" %></strong>
            at <%= @product.updated_at.strftime("%b %-d, %Y · %-I:%M%P") %>
          </span>
        <% else %>
          <span>Product #<%= @product.id %></span>
        <% end %>
      </p>
    </div>
  </div>

  <div class="papertrail-section">
    <div class="papertrail-section-heading">
      <h2>Change History</h2>
    </div>
    <%= render partial: "shared/papertrail_timeline", locals: { versions: @product.versions.includes(:item).reverse } %>
  </div>

  <div class="papertrail-section">
    <div class="papertrail-section-heading">
      <h2>Price Variants</h2>
    </div>
    <% @product.price_variants_with_removes.includes(:client).order("updated_at DESC").each do |item| %>
      <div class="papertrail-group">
        <div class="papertrail-group-heading">
          <h3><%= item.client&.name || "All Clients" %></h3>
          <% if item.removed.to_i != 0 %>
            <span class="papertrail-removed-badge">Removed</span>
          <% end %>
        </div>
        <%= render partial: "shared/papertrail_timeline", locals: {
          versions: item.versions.includes(:item).reverse,
          empty_message: "No price changes recorded yet."
        } %>
      </div>
    <% end %>
  </div>
</div>
