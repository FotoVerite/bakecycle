<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= full_title(yield(:title)) %></title>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_include_tag "application", defer: true %>
    <%= javascript_include_tag "bakecycle", defer: true %>
    <%= yield :head %>
    <%= csrf_meta_tags %>
  </head>
  <body ng-app="bakecycle">
    <div class="row full-width wrapper">
      <div class="large-12 columns content-bg">
        <%= render 'topmenusection' %>
        <div class="row">
          <%= render 'nav' if render_nav? %>
          <div class="<%= class_for_main_content %>">
            <%= render 'flash_messages' %>
            <%= yield %>
          </div>
        </div>
      </div>
    </div>
    <%= yield :js %>
    <%= render "tracking" %>
    <% if current_bakery && (!session[:saw_notification_at] || Time.parse(session[:saw_notification_at]) < Time.zone.today) %>
      <%= session[:saw_notification_at] = Time.zone.today %>
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          <% @kickoff = Time.zone.now.change({hour: 14, min:  current_bakery.kickoff_time.min }) %>
          if (<%= (Time.zone.now > @kickoff - 10.minutes && Time.zone.now < @kickoff) %>) {
            alert('Production is about to kickoff. Check if it needs any resets.')
          }
        });
      </script>
    <% end %>
  </body>
</html>
