<%= simple_form_for @shipment, html: { class: "form-stack" } do |f| %>
  <%= render partial: "shared/error_messages", locals: {f: f} %>
  <fieldset class="form-section">
    <legend>Information</legend>
    <div class="form-grid">
      <div class="form-field form-span-4">
        <%= f.input :client_id, collection: shipment.available_clients, label_method: :name, value_method: :id, prompt: "Select One", as: :select, required: true %>
      </div>
      <div class="form-field form-span-4">
        <%= f.input :date, as: :string, label: "Invoice Date", input_html: { class: "js-datepicker" } %>
      </div>
      <div class="form-field form-span-4">
        <%= f.input :route_id, collection: shipment.available_routes, label_method: :name, value_method: :id, prompt: "Select One", as: :select, required: true %>
      </div>
      <div class="form-field form-span-4">
        <%= f.input :delivery_fee %>
      </div>
      <div class="form-field form-span-4">
        <%= f.input :po_number, as: :string, label: "PO Number" %>
      </div>
      <div class="form-field form-span-4">
        <%= f.label :auto_generated %>
        <input disabled="true" type="text" value="<%= shipment.auto_generated? %>" />
      </div>
      <div class="form-field form-span-12">
        <label class="form-check">
          <%= f.check_box(:alert) %>
          <span>VIP</span>
        </label>
      </div>
      <div class="form-field form-span-12">
        <%= f.input :note, as: :text, label: "Special Notes" %>
      </div>
      <% if f.object.persisted? %>
        <div class="form-field form-span-4">
          <%= f.input :payment_due_date, as: :string, label: "Payment Due Date", readonly: true %>
        </div>
        <div class="form-field form-span-4">
          <%= f.label :production_start, "Invoice Production Start" %>
          <input disabled="true" type="text" value="<%= f.object.production_start %>" />
        </div>
      <% end %>
    </div>
  </fieldset>
  <fieldset class="form-section">
    <legend>Prices</legend>
    <div class="form-summary-grid">
      <div class="form-summary-item">
        <p><strong>Sub-total:</strong> <%= shipment.subtotal %></p>
      </div>
      <div class="form-summary-item">
        <p><strong>Delivery Fee:</strong> <%= shipment.delivery_fee %></p>
      </div>
      <div class="form-summary-item">
        <p><strong>Total Price:</strong> <%= shipment.price %></p>
      </div>
    </div>
  </fieldset>
  <fieldset class="form-section shipment-products-section" data-controller="nested-form">
    <legend>Products</legend>
    <div class="nested-col-headers form-grid nested-row-grid shipment-item-grid">
      <div class="nested-col-label shipment-product-cell">Product <abbr title="required">*</abbr></div>
      <div class="nested-col-label shipment-type-cell">Type</div>
      <div class="nested-col-label shipment-quantity-cell">Quantity</div>
      <div class="nested-col-label shipment-price-cell">Price</div>
      <div class="nested-col-label shipment-production-start-cell">Production Start</div>
      <div class="nested-col-label shipment-status-cell">In Production</div>
      <div class="shipment-actions-cell"></div>
    </div>
    <%= render partial: "shipment_items", locals: { f: f, shipment: shipment } %>
  </fieldset>
  <div class="form-actions">
    <%= f.submit (f.object.new_record? ? "Create" : "Update"), class: "button", name: nil %>
    <% unless f.object.new_record? %>
      <%= link_to 'Delete', shipment_path(f.object), class: "button alert",
                                data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' } %>
    <% end %>
  </div>
<% end %>
