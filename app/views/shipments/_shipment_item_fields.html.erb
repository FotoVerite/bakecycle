<% products = shipment.available_products %>
<% product_options = products.map { |product| [product.name, product.id] } %>
<% product_types = products.each_with_object({}) do |product, hash|
     hash[product.id] = product.product_type.humanize(capitalize: false).titleize
   end %>
<% product_type = f.object.respond_to?(:product_type) ? f.object.product_type : f.object.product_product_type.to_s.humanize(capitalize: false).titleize %>
<% production_locked = f.object.production_run_id.present? %>

<div class="nested-row form-grid nested-row-grid shipment-item-grid"
     data-controller="shipment-item"
     data-nested-row="true"
     data-shipment-item-prices-value="<%= shipment.product_prices %>"
     data-shipment-item-product-types-value="<%= product_types.to_json %>">

  <% if f.object.persisted? %>
    <%= f.hidden_field :id %>
    <%= f.hidden_field :_destroy, value: "", data: { destroy_field: "" } %>
  <% end %>

  <div class="form-field shipment-product-cell">
    <%= f.select :product_id,
        options_for_select([["Select Product", ""]] + product_options, f.object.product_id),
        {},
        class: "nested-field",
        required: true,
        data: {
          controller: "tom-select",
          placeholder: "Search products",
          shipment_item_target: "product",
          action: "change->shipment-item#productChanged"
        } %>
  </div>

  <div class="shipment-item-readonly shipment-type-cell" data-shipment-item-target="type">
    <%= product_type %>
  </div>

  <div class="form-field shipment-quantity-cell">
    <%= f.number_field :product_quantity,
        class: "nested-field product_quantity_input",
        disabled: production_locked,
        min: 0,
        step: 1,
        autocomplete: "off",
        data: { action: "focus->shipment-item#selectContents" } %>
  </div>

  <div class="form-field shipment-price-cell">
    <%= f.number_field :product_price,
        class: "nested-field product_price_input",
        value: f.object.respond_to?(:float_product_price) ? f.object.float_product_price : f.object.product_price,
        min: 0,
        step: "0.01",
        autocomplete: "off",
        data: {
          shipment_item_target: "price",
          action: "focus->shipment-item#selectContents"
        } %>
  </div>

  <div class="shipment-item-readonly shipment-production-start-cell">
    <%= f.object.production_start %>
  </div>

  <div class="shipment-item-status shipment-status-cell">
    <% if f.object.production_start.present? && f.object.product_total_lead_days.present? && (f.object.in_production? || f.object.after_production?) %>
      <% if f.object.production_run_id %>
        <span class="shipment-item-status-pill shipment-item-status-pill--success">
          <%= icon("square-check") %> Yes
        </span>
      <% else %>
        <span class="shipment-item-status-pill shipment-item-status-pill--danger">
          <%= icon("x") %> No
        </span>
      <% end %>
    <% else %>
      <span class="shipment-item-status-pill">NA</span>
    <% end %>
  </div>

  <div class="nested-row-actions shipment-actions-cell">
    <% unless production_locked %>
      <button type="button"
              class="nested-icon-btn nested-btn-remove"
              data-action="nested-form#remove"
              title="Remove">
        <%= icon("x") %>
      </button>
      <% if f.object.persisted? %>
        <button type="button"
                class="nested-icon-btn nested-btn-restore"
                data-action="nested-form#restore"
                title="Restore"
                hidden>
          <%= icon("rotate-ccw") %>
        </button>
      <% end %>
    <% end %>
  </div>
</div>
