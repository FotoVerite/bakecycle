<% provide(:title, "Invoices") %>

<div class="index-page">
  <div class="index-header">
    <div>
      <h1>Invoices</h1>
      <p>Find invoices by number, client, product, or delivery date.</p>
    </div>

    <% if policy(Shipment).new? %>
      <div class="index-header-actions">
        <%= link_to 'Add New Invoice', new_shipment_path, class: "button index-header-action" %>
        <%= render "shared/pin_action_menu", action_key: "new_invoice" %>
      </div>
    <% end %>
  </div>

  <%= render partial: 'search_form', object: search_form %>

  <div class="index-filter-feedback">
    <div class="index-filter-results" role="status" aria-live="polite" aria-atomic="true">
      <strong><%= pluralize(number_with_delimiter(@shipments.total_entries), 'invoice') %></strong>
    </div>

    <% if @search_active %>
      <%= link_to shipments_path, class: "index-filter-reset" do %>
        <%= icon("rotate-ccw") %>
        Reset filters
      <% end %>
    <% end %>
  </div>

  <% if @double_invoices.any? %>
    <details class="index-alert-panel duplicate-invoices panel callout radius" open>
      <summary class="index-alert-heading">
        <span>Needs attention</span>
        <strong><%= pluralize(@double_invoices.count, 'duplicate invoice') %></strong>
        <% if @duplicate_invoice_count_in_results.positive? %>
          <small><%= pluralize(@duplicate_invoice_count_in_results, 'flagged invoice') %> will be included in exports from the current results. Review them before exporting.</small>
        <% else %>
          <small>These invoices need review, but they are not included in the current export results.</small>
        <% end %>
      </summary>
      <table class="responsive-table orders-missing-shipment-table">
        <thead>
          <tr>
            <th scope="col">Invoice</th>
            <th scope="col">Date</th>
            <th scope="col">Updated</th>
            <th scope="col">Client</th>
            <th scope="col">Price</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
        <% @double_invoices.each do |shipment| %>
          <%= render 'double_shipment', shipment: ShipmentDecorator.decorate(shipment) %>
        <% end %>
        </tbody>
      </table>
    </details>
  <% end %>

  <% if @shipments.any? %>
    <div class="index-actions">
      <div class="index-actions-summary">
        <span>Export scope</span>
        <strong><%= pluralize(number_with_delimiter(@shipments.total_entries), 'invoice') %> in current results</strong>
        <small><%= invoice_search_scope_description(search_form, shipments) %></small>
      </div>

      <div class="index-action-buttons">
      <% search_params = params[:search].permit(ShipmentSearchForm.params) if params[:search] %>
      <%= link_to export_pdf_shipments_path(search: search_params), data: { turbo_stream: true }, class: "button small" do %>
          <%= icon("file-text") %> Export invoice PDFs
      <% end %>

      <%= link_to export_csv_shipments_path(search: search_params), data: { turbo_stream: true }, class: "button small secondary" do %>
        <%= icon("file-spreadsheet") %> Export CSV
      <% end %>

      <%= link_to export_iif_shipments_path(search: search_params), data: { turbo_stream: true }, class: "button small secondary" do %>
        <%= icon("dollar-sign") %> Export QuickBooks IIF
      <% end %>
      </div>
    </div>
  <% end %>

  <% if @shipments.any? %>
    <div class="index-table">
      <table class="responsive-table all-invoices">
        <thead>
          <tr>
            <th scope="col">Invoice</th>
            <th scope="col">Date</th>
            <th scope="col">Client</th>
            <th scope="col">Price</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <%= render shipments %>
        </tbody>
      </table>
    </div>

    <%= will_paginate @shipments %>
  <% else %>
    <div class="index-empty-state">
      <%= icon("search") %>
      <div>
        <% if @search_active %>
          <h2>No invoices match these filters</h2>
          <p>Try a different invoice number, client, product, or date range, or reset the filters above.</p>
        <% else %>
          <h2>No invoices yet</h2>
          <p>Create an invoice to start tracking deliveries and exports.</p>
          <% if policy(Shipment).new? %>
            <%= link_to "Create invoice", new_shipment_path, class: "button small" %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
