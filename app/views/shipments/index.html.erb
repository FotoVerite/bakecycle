<% provide(:title, "Invoices") %>

<div class="index-page">
  <div class="index-header">
    <div>
      <h1>Invoices</h1>
      <p>Search, export, and manage invoice records.</p>
    </div>

    <% if policy(Shipment).new? %>
      <div class="index-header-actions">
        <%= link_to 'Add New Invoice', new_shipment_path, class: "button index-header-action" %>
        <%= render "shared/pin_action_menu", action_key: "new_invoice" %>
      </div>
    <% end %>
  </div>

  <%= render partial: 'search_form', object: search_form %>

  <% if @shipments.any? %>
    <div class="index-actions">
      <div class="index-actions-summary">
        <span>Exports</span>
        <strong>Current invoice results</strong>
      </div>

      <div class="index-action-buttons">
      <% search_params = params[:search].permit(ShipmentSearchForm.params) if params[:search] %>
      <%= link_to export_pdf_shipments_path(search: search_params), target: '_blank', class: "button small" do %>
          <i class="fi-page-export-pdf"></i> Export Invoices
      <% end %>

      <%= link_to export_csv_shipments_path(search: search_params), target: "_blank", class: "button small secondary" do %>
        <i class="fi-page-export-csv"></i> Export CSV
      <% end %>

      <%= link_to export_iif_shipments_path(search: search_params), target: "_blank", class: "button small secondary" do %>
        <i class="fi-page-export"></i> Export QuickBooks
      <% end %>
      </div>
    </div>
  <% end %>

  <% if !@double_invoices.empty?  %>
   <div class="dublicate_invoices panel callout radius">
      <h5 style='font-size:24px;'>These <%= pluralize(@double_invoices.count, 'invoices') %> are duplicates. Please fix as soon as possible.</h5>
      <table class="responsive-table orders-missing-shipment-table">
        <thead>
          <tr>
            <th scope="col">Invoice</th>
            <th scope="col">Date</th>
            <th scope="col">Updated At</th>
            <th scope="col">Client</th>
            <th scope="col">Price</th>
            <th scope="col">Action</th>
          </tr>
        </thead>
        <tbody>
        <% @double_invoices.each do |shipment| %>
          <%= render 'double_shipment', shipment: ShipmentDecorator.decorate(shipment) %>
        <% end %>
        </tbody>
      </table>
    </div><% end %>

  <div class="index-table">
    <table class="responsive-table all-invoices">
      <thead>
        <tr>
          <th scope="col">Invoice</th>
          <th scope="col">Date</th>
          <th scope="col">Client</th>
          <th scope="col">Price</th>
          <th scope="col">Action</th>
        </tr>
      </thead>
      <tbody>
        <%= render shipments %>
      </tbody>
    </table>
  </div>

  <%= will_paginate @shipments %>
</div>
