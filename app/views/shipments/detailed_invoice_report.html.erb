<% provide(:title, "Detailed Invoice Report") %>

<h1>Detailed Invoice Report</h1>
<%= link_to "Back to Reports", reports_path, class: "button small" %>

<%= simple_form_for "", url: print_detailed_invoice_report_shipments_path, method: :get, :html => {:target => '_blank'}  do |f| %>
  <div class="row collapse">
    <div class="small-12 medium-3 columns">
      <%= f.input :start_date, input_html: { value: @start_date.strftime("%Y-%m-%d"), class: "js-datepicker", name: :start_date}, required: false %>
    </div>
    <div class="small-12 medium-3 columns end">
      <%= f.input :end_date, input_html: { value: @end_date.strftime("%Y-%m-%d"), class: "js-datepicker", name: :end_date}, required: false %>
    </div>
  </div>
<%= button_tag "<i class='fi-page-export-pdf'></i> Print Report".html_safe, name: 'type', value: 'daily' %>
<% end %>
