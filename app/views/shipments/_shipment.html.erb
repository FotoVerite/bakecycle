<tr class="js-clickable-row" href="<%= edit_shipment_path(shipment) %>">
  <th scope="row"><%= shipment.invoice_number %></th>
  <td data-title="Date"><%= shipment.date %></td>
  <td data-title="Client Name"><%= shipment.client_name %></td>
  <td data-title="Price"><%= shipment.price %></td>
  <td data-title="Actions">
    <%= action_icon edit_shipment_path(shipment), icon_name: "pencil", label: "Edit Invoice", variant: "edit" %>
    <%= action_icon invoice_shipment_path(shipment), icon_name: "file-text", label: "Invoice", variant: "document",
          link_data: { turbo_stream: true } %>
    <%= action_icon packing_slip_shipment_path(shipment), icon_name: "clipboard-list", label: "Packing Slip", variant: "fulfillment",
          link_data: { controller: "sync-download", action: "click->sync-download#start" },
          span_data: { sync_download_target: "icon" } %>
    <%= action_icon invoice_iif_shipment_path(shipment), icon_name: "dollar-sign", label: "Quickbooks IIF", variant: "financial",
          link_data: { controller: "sync-download", action: "click->sync-download#start" },
          span_data: { sync_download_target: "icon" } %>
    <%= action_icon invoice_csv_shipment_path(shipment), icon_name: "file-spreadsheet", label: "CSV", variant: "document",
          link_data: { turbo_stream: true } %>
  </td>
</tr>
