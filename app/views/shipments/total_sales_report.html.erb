<% provide(:title, "Total Sales Report") %>

<div class="report-page report-generator-page">
  <%= render "shared/report_header",
    title: "Total Sales Report",
    date_text: "#{@start_date.strftime('%A %b. %e, %Y')} to #{@end_date.strftime('%A %b. %e, %Y')}",
    status: "Invoice report" %>

  <div class="report-toolbar">
    <%= simple_form_for "", url: print_total_sales_report_shipments_path, method: :get, html: { target: "_blank", class: "report-print-form" } do |f| %>
      <div class="report-date-form report-date-range-form">
        <%= f.input :start_date, input_html: { value: @start_date.strftime("%Y-%m-%d"), class: "js-datepicker", name: :start_date }, required: false %>
        <%= f.input :end_date, input_html: { value: @end_date.strftime("%Y-%m-%d"), class: "js-datepicker", name: :end_date }, required: false %>
        <%= button_tag "<i class='fi-page-export-pdf'></i> Print Report".html_safe, name: "type", value: "daily", class: "button search-button" %>
      </div>
    <% end %>
    <div class="report-toolbar-note">
      <span>Sales summary</span>
      Prints total sales for invoices in this date range.
    </div>
  </div>

  <%= link_to "Back to Reports", reports_path, class: "button small secondary report-back-link" %>
</div>
