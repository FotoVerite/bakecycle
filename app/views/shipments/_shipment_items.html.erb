<div data-nested-form-target="rows">
  <%= f.simple_fields_for :shipment_items, shipment.sorted_shipment_items do |builder| %>
    <%= render "shipment_item_fields", f: builder, shipment: shipment %>
  <% end %>
</div>

<template data-nested-form-target="template">
  <%= f.simple_fields_for :shipment_items, ShipmentItem.new, child_index: "NEW_RECORD" do |builder| %>
    <%= render "shipment_item_fields", f: builder, shipment: shipment %>
  <% end %>
</template>

<button type="button"
        class="button small nested-add-btn"
        data-action="nested-form#add">
  + Add Product
</button>
