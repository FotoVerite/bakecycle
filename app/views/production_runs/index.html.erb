<% provide(:title, "Production Runs") %>

<div class="index-page production-runs-index">
  <div class="index-header">
    <div>
      <h1>Production Runs</h1>
      <p>Search scheduled runs and open the production detail or printable recipe packet.</p>
    </div>
  </div>

  <%= simple_form_for :search, method: :get, html: { class: "index-toolbar index-toolbar-production-runs bakecycle-form" } do |f| %>
    <div class="index-filter index-filter-medium">
      <%= f.input :date, input_html: { value: @date&.strftime("%Y-%m-%d"), class: "js-datepicker", name: :date }, label: "Date", required: false %>
    </div>
    <div class="index-toolbar-actions">
      <%= f.submit 'Search', class: "button search-button", name: nil %>
    </div>
  <% end %>

  <div class="index-table">
    <table class="responsive-table">
      <thead>
        <tr>
          <th>Id</th>
          <th>Date</th>
          <th>Product Count</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody>
        <%= render @production_runs %>
      </tbody>
    </table>
  </div>

  <%= will_paginate @production_runs %>
</div>
