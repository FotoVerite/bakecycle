<% provide(:title, "Print Recipes - #{@date.strftime('%A %b. %e, %Y')}") %>

<div class="report-page">
  <%= render "shared/report_header",
    title: "Print Recipes",
    date_text: @date.strftime("%A %b. %e, %Y"),
    status: (@production_run ? "Production run" : "Projection"),
    pin_action_key: "daily_recipes" %>

  <%= render "shared/report_date_toolbar",
    url: print_recipes_path,
    date: @date,
    note_label: (@production_run ? "Saved production run" : "Active orders projection"),
    note: (@production_run ? "Recipes are based on the saved run for this date." : "Quantities are projected from active orders for this date.") %>

  <% if @production_run %>
    <%= render 'form' %>
  <% else %>
    <%= render 'shared/projections' %>
  <% end %>
</div>
