<% provide(:title, "Generate Weekly/Daily Reports") %>

<div class="report-page report-generator-page">
  <%= render "shared/report_header",
    title: "Production Totals",
    date_text: @date.strftime("%A %b. %e, %Y"),
    status: "Daily or weekly" %>

  <div class="report-toolbar">
    <%= simple_form_for "", url: print_weekly_daily_production_report_production_runs_path, method: :get, html: { target: "_blank", class: "report-print-form" } do |f| %>
      <div class="report-date-form report-date-form-with-actions">
        <%= f.input :date, input_html: { value: @date.strftime("%Y-%m-%d"), class: "js-datepicker", name: :date}, required: false %>
        <div class="report-action-buttons">
          <%= button_tag "#{icon('file-text')} Daily Totals".html_safe, name: "type", value: "daily", class: "button search-button" %>
          <%= button_tag "#{icon('file-text')} Weekly Totals".html_safe, name: "type", value: "weekly", class: "button secondary search-button" %>
        </div>
      </div>
    <% end %>
    <div class="report-toolbar-note">
      <span>Production report</span>
      Choose daily or weekly production totals for the selected date.
    </div>
  </div>

  <%= link_to "Back to Reports", reports_path, class: "button small secondary report-back-link" %>
</div>
