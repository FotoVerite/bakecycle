<div data-controller="production-run-items">
  <table class="responsive-table recent-shipment">
    <thead>
      <tr>
        <th>Product</th>
        <th>Total Quantity</th>
        <th>Order Quantity</th>
        <th>Over Bake %</th>
        <th>Over Bake Quantity</th>
        <% if policy(@production_run).update? %>
          <th>Delete</th>
        <% end %>
      </tr>
    </thead>

    <tbody data-production-run-items-target="rows">
      <%= f.simple_fields_for :run_items, @production_run.run_items.order_by_product_type_and_name do |builder| %>
          <%= render 'run_item_fields', f: builder %>
      <% end %>
    </tbody>
  </table>

  <template data-production-run-items-target="template">
    <tr class="fields">
      <%= f.simple_fields_for :run_items, @production_run.run_items.build, child_index: '${ID}' do |builder| %>
        <%= render 'new_run_item_fields', f: builder %>
      <% end %>
    </tr>
  </template>

  <% if policy(@production_run).update? %>
    <% if f.object.persisted? || params[:action] == 'test_projection' %>
      <%= button_tag 'Add Product', type: 'button', data: { action: 'production-run-items#add' }, class: 'button' %>
    <% end %>
  <% end %>
</div>
