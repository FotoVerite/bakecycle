<tr class="js-clickable-row" id="production_run_<%= production_run.id %>" href="<%= edit_production_run_path(production_run) %>">
  <td data-title="Id"><%= production_run.id %></td>
  <td data-title="Date"><%= production_run.date %></td>
  <td data-title="Product Count"><%= @run_item_counts.fetch(production_run.id, 0) %></td>
  <td data-title="Actions">
    <%= link_to edit_production_run_path(production_run) do %>
      <span class="table-action-icon table-action-icon--edit icon-link-tooltip" aria-label="Edit Run"><i class="fi-page-edit"></i></span>
    <% end %>
    <%= link_to print_production_run_path(production_run, format: :pdf), target: "_blank" do %>
      <span class="table-action-icon table-action-icon--document icon-link-tooltip" aria-label="Print Run"><i class="fi-page-export-pdf"></i></span>
    <% end %>
  </td>
</tr>
