<%= simple_form_for @route, html: { class: "form-stack" } do |f| %>

  <%= render partial: "shared/error_messages", locals: {f: f} %>

  <fieldset class="form-section">
    <legend>Route Information</legend>
    <div class="form-grid">
      <div class="form-field form-span-9">
        <%= f.input :name, as: :string %>
      </div>

      <div class="form-field form-span-3 select-time-wrapper">
        <%= f.input :departure_time, as: :string, placeholder: "Select Time", input_html: { value: "#{route.formatted_time}", class: "js-timepicker" } %>
      </div>

      <div class="form-field form-span-12">
        <%= f.input :notes, as: :text%>
      </div>

      <div class="form-field form-span-6">
        <span class="form-field-label">Active</span>
        <div class="form-choice-row">
          <label class="form-choice">
            <%= f.radio_button(:active, true) %>
            <span>Yes</span>
          </label>
          <label class="form-choice">
            <%= f.radio_button(:active, false) %>
            <span>No</span>
          </label>
        </div>
      </div>
    </div>
  </fieldset>

  <div class="form-actions">
    <%= f.submit (@route.new_record? ? "Create" : "Update"), class: "button", name: nil %>
    <% unless @route.new_record? %>
      <%= link_to 'Delete', route_path(@route), class: "button alert",
                                method: :delete, data: { confirm: 'Are you sure?' } %>
    <% end %>
  </div>
<% end %>
