<% provide(:title, "Editing Route: #{route.name}") %>

<div class="form-page">
  <div class="form-header">
    <div>
      <h1>Editing Route: <%= route.name %></h1>
      <p>Update delivery route timing, notes, and availability.</p>
    </div>

    <div class="form-header-actions">
      <%= link_to 'Back', routes_path, class: "button small secondary" %>
    </div>
  </div>

  <%= render 'form' %>
</div>
