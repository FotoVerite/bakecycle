<% provide(:title, "Packing Slips - #{@date.strftime('%A %b. %e, %Y')}") %>

<div class="report-page">
  <%= render "shared/report_header",
    title: "Packing Slips",
    date_text: @date.strftime("%A %b. %e, %Y"),
    status: pluralize(@shipments.count, "invoice") %>

  <%= render "shared/report_date_toolbar",
    url: packing_slips_path,
    date: @date,
    note_label: "Packing workflow",
  note: "Print packing lists, sorted lists, or packing slips for this date." %>

  <% if @shipments.any? %>
    <%= render partial: "packing_slips/packing_slips", locals: { shipments: @shipments } %>
  <% else %>
    <h2>No packing slips for this date.</h2>
  <% end %>
</div>
