<div class="report-actions">
  <div>
    <p class="projection">Packing documents for selected invoices</p>
  </div>
  <div class="report-action-buttons">
    <%= simple_form_for :print, url: print_list_packing_slips_path, method: :get, html: { data: { turbo_stream: true } } do |f| %>
      <%= f.hidden_field :date, value: @date.strftime("%Y-%m-%d") %>
      <%= f.submit 'Print Packing List', class: "button small", action: 'print', name: nil %>
    <% end %>

    <%= simple_form_for :print, url: print_sorted_list_packing_slips_path, method: :get, html: { data: { turbo_stream: true } } do |f| %>
      <%= f.hidden_field :date, value: @date.strftime("%Y-%m-%d") %>
      <%= f.submit 'Print Sorted List', class: "button small secondary", action: 'print', name: nil %>
    <% end %>

    <%= simple_form_for :print, url: print_packing_slips_path, method: :get, html: { data: { turbo_stream: true } } do |f| %>
      <%= f.hidden_field :date, value: @date.strftime("%Y-%m-%d") %>
      <label class="report-checkbox">
        <%= f.input_field :include_invoices, as: :boolean, required: false, checked: true %>
        Include invoices
      </label>
      <%= f.submit 'Print Packing Slips', class: "button small secondary", action: 'print', name: nil %>
    <% end %>
  </div>
</div>

<table class="responsive-table report-table">
  <thead>
    <tr>
      <th scope="col">Client</th>
      <th scope="col">Route</th>
      <th scope="col">Departure Time</th>
    </tr>
  </thead>
  <tbody>
    <% shipments.each do |shipment| %>
      <tr>
        <th scope="row"><%= shipment.client_name %></th>
        <td data-title="Route Name"><%= shipment.route_name %></td>
        <td data-title="Departure Time"><%= shipment.route_departure_time.strftime("%I:%M%p") %></td>
      </tr>
    <% end %>
  </tbody>
</table>
