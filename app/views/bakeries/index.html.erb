<% provide(:title, "Bakeries") %>

<div class="index-page">
  <div class="index-header">
    <div>
      <h1>Bakeries</h1>
      <p>Manage bakery accounts and plan assignments.</p>
    </div>

    <%= link_to 'Add New Bakery', new_bakery_path, class: "button index-header-action" %>
  </div>

  <div class="index-table">
    <table class="responsive-table">
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Plan</th>
          <th scope="col">Action</th>
        </tr>
      </thead>
      <tbody>
        <% @bakeries.each do |bakery| %>
          <tr class="js-clickable-row" href="<%= edit_bakery_path(bakery) %>">
            <th scope="row"><%= link_to bakery.name, edit_bakery_path(bakery) %></th>
            <th scope="row" title="<%= bakery.plan.name %>"><%= bakery.plan.display_name %></th>
            <td data-title="Action">
              <%= link_to edit_bakery_path(bakery) do %>
                <span class="table-action-icon icon-link-tooltip" aria-label="Edit Bakery"><i class="fi-page-edit"></i></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
