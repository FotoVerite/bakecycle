<style>
p {
      clear: both;
      border-bottom: 1px solid gray;
}
.amount {
      float: right;
}

</style>
<h1 style="font-size:12px;text-align:center;">Bakecycle Sales Report<h1>
<p style="border:none;margin-bottom:24px;">Jan. 2020–Dec. 2020 | Bien Cuit Wholesale</p>
<h2 style="margin-bottom:48px;"><%=@start_date.strftime("%A %B %e, %Y")%> - <%=@end_date.strftime("%A %B %e, %Y")%> <h2>
<h3>Clients</h3>
<% @total = 0 %>
 <% @clients.each do |client| %>
 <%  invoices = client.shipments.where("shipments.date BETWEEN ? AND ?", @start_date, @end_date);
      invoice_total = invoices.to_a.sum(&:price);
      @total += invoice_total %>
<p style="padding:12px;"><%= client.name %> <span class='amount'> <%= number_to_currency invoice_total %></span></p>
<% end %>
<p style="padding:12px;border:none;">
<b>Total Sales: <span class='amount'><%=number_to_currency @total %></span></b>
</p>