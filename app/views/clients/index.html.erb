<% provide(:title, "Clients") %>

<div class="index-page">
  <div class="index-header">
    <div>
      <h1>Clients</h1>
      <p>Find clients by name, status, or active account state.</p>
    </div>

    <% if policy(Client).new? %>
      <%= link_to 'Add New Client', new_client_path, class: "button index-header-action" %>
    <% end %>
  </div>

  <div data-controller="filter-table">
    <%= form_with url: clients_path,
                  method: :get,
                  class: "index-toolbar bakecycle-form",
                  data: {
                    filter_table_target: "form",
                    turbo_frame: "clients"
                  } do %>
      <div class="index-filter index-filter-primary">
        <div class="input string optional">
          <label class="string optional">Client name</label>
          <input class="string optional"
                 placeholder="Search clients"
                 type="text"
                 name="filter[name]"
                 value="<%= @client_filter[:name] %>"
                 data-filter-table-target="nameInput"
                 data-action="input->filter-table#scheduleSubmit keydown->filter-table#navigateIfOne" />
        </div>
      </div>
      <div class="index-filter index-filter-medium">
        <div class="input string optional">
          <label class="string optional">Status</label>
          <select name="filter[status]"
                  data-filter-table-target="statusSelect"
                  data-action="change->filter-table#filter">
            <%= options_for_select([
                  ["Current", "current"],
                  ["Lapsed", "lapsed"],
                  ["Prospective", "prospective"],
                  ["Any", "any"]
                ], @client_filter[:status]) %>
          </select>
        </div>
      </div>
      <div class="index-filter index-filter-small">
        <div class="input string optional">
          <label class="string optional">Active</label>
          <select name="filter[active]"
                  data-filter-table-target="activeSelect"
                  data-action="change->filter-table#filter">
            <%= options_for_select([
                  ["Yes", "true"],
                  ["No", "false"],
                  ["Any", "any"]
                ], @client_filter[:active]) %>
          </select>
        </div>
      </div>
      <div class="index-toolbar-actions">
        <a class="button small secondary"
           target="_blank"
           href="<%= print_client_list_clients_path(type: @client_filter[:active]) %>"
           data-filter-table-target="exportLink">Export active clients</a>
      </div>
    <% end %>

    <%= turbo_frame_tag "clients" do %>
      <%= render partial: "clients/client_table", locals: { clients: @clients, client_filter: @client_filter } %>
    <% end %>
  </div>
</div>
