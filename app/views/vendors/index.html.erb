<% provide(:title, "Vendors") %>

<div class="index-page">
  <div class="index-header">
    <div>
      <h1>Vendors</h1>
      <p>Manage vendor records, pricing, and buy orders.</p>
    </div>

    <% if policy(Product).new? %>
      <%= link_to 'Add New Vendor', new_vendor_path, class: "button index-header-action" %>
    <% end %>
  </div>

  <div class="index-table">
    <table class="responsive-table">
      <thead>
        <tr>
          <th scope="col">Name</th>
          <% if policy(Product).manage_permission? %>
            <th scope="col">Action</th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @vendors.each do |vendor| %>
          <tr class="js-clickable-row" href="<%= edit_vendor_path(vendor) %>">
            <th scope="row"><%= link_to vendor.name, edit_vendor_path(vendor) %></th>
            <% if policy(vendor).edit? %>
              <td data-title="Action">
                <%= action_icon pricing_vendor_path(vendor), icon_name: "pencil", label: "Price Ingredients", variant: "edit" %>
                <%= action_icon buy_orders_vendor_path(vendor), icon_name: "database", label: "Buy Orders", variant: "financial" %>
                <%= action_icon edit_vendor_path(vendor), icon_name: "pencil", label: "Edit Vendor", variant: "edit" %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
