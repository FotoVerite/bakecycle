<%= simple_form_for @vendor, html: { class: "form-stack" } do |f| %>

  <%= render partial: "shared/error_messages", locals: {f: f} %>

  <fieldset class="form-section">
    <legend>Vendor Information</legend>
    <div class="form-grid">
      <div class="form-field form-span-6">
        <%= f.input :name, as: :string %>
      </div>
       <div class="form-field form-span-6">
        <%= f.input :contact, as: :string %>
      </div>
       <div class="form-field form-span-6">
        <%= f.input :email, as: :email %>
      </div>
       <div class="form-field form-span-6">
        <%= f.input :phone, as: :string %>
      </div>
    </div>
  </fieldset>
  <div class="form-actions">
    <% if @vendor.new_record? && policy(@vendor).create? %>
      <%= f.submit "Create", class: "button", name: nil %>
    <% end %>

    <% if @vendor.persisted? && policy(@vendor).update?%>
      <%= f.submit "Update", class: "button", name: nil %>
    <% end %>

    <% if @vendor.persisted? && policy(@vendor).destroy? %>
      <%= link_to 'Delete', vendor_path(@vendor), class: "button alert",
                  data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' } %>
    <% end %>
  </div>
<% end %>
