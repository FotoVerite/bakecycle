<h1>Buy Orders for <%= @vendor.name %></h1>
<%= form_for @vendor, url: update_buy_orders_vendor_path(@vendor) do |f| %>
  <% index = 0 %>
  <% @ingredients.each do | i| %>
    <% over_time = i.ingredient_prices_over_time.find_by(vendor_id: @vendor.id) %>
    <% next unless over_time.present? %>
    <h2><%= i.name %></h2>
    <div id="ingredient-<%= i.id %>"></div>
    <%= f.fields_for :buy_order_attributes do |buy_order| %>
    <fieldset class="large-6 cell">
      <legend>Choose Buying Option for Today</legend>
      <% buy_order  = @vendor.buy_orders.find_by(ingredient_id: i.id) %>
      <% buy_order = buy_order.try(:created_at).try(:to_date) == Date.today ? buy_order : nil %>
      <%= hidden_field_tag("vendor[buy_orders_attributes][#{index}][id]", buy_order.id) if buy_order %>
      <%= hidden_field_tag("vendor[buy_orders_attributes][#{index}][ingredient_id]", i.id)%>
      <p>Cost per <%= (over_time.weight_unit || 'Grams') %>: <%= number_to_currency(over_time.cost_per_unit) %></p>
      <%= label_tag "", "Amount to buy", for: "vendor[buy_orders_attributes][#{index}][amount]" %>
      <%= number_field_tag("vendor[buy_orders_attributes][#{index}][amount]", buy_order.try(:amount) || 0, step: "0.001", id: "vendor[buy_order_attributes][#{index}][amount]") %>
      <% index = index + 1 %>
    </fieldset>
    <% end %>
  <% end %>
  <%= f.submit "Update", class: "button", name: nil %>
<% end %>