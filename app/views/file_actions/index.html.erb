<div class="index-page">
  <div class="index-header">
    <div>
      <h1>File Actions</h1>
      <p>Review recent export and download activity.</p>
    </div>
  </div>

  <ul class="file-actions">
    <% @file_actions.each do |action| %>
      <li><%= action.user.name %> <%= action.action %> <%= action.file_export.file_file_name %> <%= action.created_at.strftime("%-m/%d/%y %I:%M %p") %></li>
    <% end %>
  </ul>
</div>
