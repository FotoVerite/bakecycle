<div class="report-header">
  <div>
    <h1><%= title %></h1>
    <% if local_assigns[:date_text].present? %>
      <p><%= date_text %></p>
    <% end %>
  </div>
  <div class="report-header-actions">
    <% if local_assigns[:status].present? %>
      <span class="report-status"><%= status %></span>
    <% end %>
    <% if local_assigns[:pin_action_key].present? %>
      <%= render "shared/pin_action_menu", action_key: pin_action_key %>
    <% end %>
  </div>
</div>
