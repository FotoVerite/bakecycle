<% provide(:title, "Users") %>

<div class="index-page">
  <div class="index-header">
    <div>
      <h1>Users</h1>
      <p>Manage team access, permissions, and invitations.</p>
    </div>

    <% if policy(User).new? %>
      <%= link_to 'Add New User', new_user_path, class: "button index-header-action" %>
    <% end %>
  </div>

  <div class="index-table">
    <table class="responsive-table">
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Email</th>
          <% if current_user.admin? %>
            <th scope="col">Bakery</th>
          <% end %>
          <th scope="col">Action</th>
        </tr>
      </thead>
      <tbody>
        <% users.each do |user| %>
          <tr class="js-clickable-row" href="<%= edit_user_path(user) %>">
            <th scope="row"><%= link_to user.name, edit_user_path(user) %></th>
            <td data-title="Email"><%= user.email %></td>
            <% if current_user.admin? %>
              <td data-title="Bakery"><%= user.bakery_name %></td>
            <% end %>
            <td data-title="Action">
              <%= link_to edit_user_path(user) do %>
                <span class="table-action-icon table-action-icon--edit icon-link-tooltip" aria-label="Edit User"><%= icon("pencil") %></span>
              <% end %>
              <% if user.invited_to_sign_up? %>
                <%= link_to send_user_invitation_path(user), data: { turbo_method: :post } do %>
                  <span class="table-action-icon table-action-icon--document icon-link-tooltip" aria-label="Resend Confirmation Email"><%= icon("mail") %></span>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
