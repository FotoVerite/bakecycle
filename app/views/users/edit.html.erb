<% provide(:title, "Editing User: #{@user.name}") %>

<div class="form-page">
  <div class="form-header">
    <div>
      <h1>Editing User: <%= @user.name %></h1>
      <p>Update user profile, bakery access, and permissions.</p>
    </div>

    <div class="form-header-actions">
      <% if policy(User).index? %>
        <%= link_to 'Back', users_path, class: "button small secondary" %>
      <% end %>
    </div>
  </div>

  <%= render 'form' %>
</div>
