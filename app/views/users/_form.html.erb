<%= simple_form_for @user, html: { class: "form-stack" } do |f| %>

  <%= render partial: "shared/error_messages", locals: {f: f} %>

  <fieldset class="form-section">
    <legend>User Information</legend>
    <div class="form-grid">
      <div class="form-field form-span-6">
        <%= f.input :name, as: :string %>
      </div>
      <div class="form-field form-span-6">
        <%= f.input :email, as: :string, required: true %>
      </div>

      <div class="form-field form-span-6">
        <%= f.input :password, as: :password %>
        <% unless @user.persisted? %>
          <p class="help-text">
            * Leave password blank to send an invitation email
          </p>
        <% end %>
      </div>
      <div class="form-field form-span-6">
        <%= f.input :password_confirmation, as: :password %>
      </div>

      <div class="form-field form-span-6">
        <% if current_user.admin? %>
          <%= f.input(
            :bakery_id,
            collection: Bakery.all,
            label_method: :name,
            value_method: :id,
            include_blank: 'None',
            as: :select
          ) %>
        <% end %>
      </div>
    </div>
  </fieldset>

  <% if policy(@user).manage_permission? %>
    <fieldset class="form-section">
      <legend>Permissions</legend>
      <div class="form-grid">
        <div class="form-field form-span-6">
          <%= f.input(
            :user_permission,
            collection: user.access_level,
            as: :select,
            include_blank: false
          ) %>
        </div>

        <div class="form-field form-span-6">
          <%= f.input(
            :product_permission,
            collection: user.access_level,
            as: :select,
            include_blank: false
          ) %>
        </div>

        <div class="form-field form-span-6">
          <%= f.input(
            :bakery_permission,
            collection: user.access_level,
            as: :select,
            include_blank: false
          ) %>
        </div>

        <div class="form-field form-span-6">
          <%= f.input(
            :client_permission,
            collection: user.access_level,
            as: :select,
            include_blank: false
          ) %>
        </div>

        <div class="form-field form-span-6">
          <%= f.input(
            :shipping_permission,
            collection: user.access_level,
            as: :select,
            include_blank: false
          ) %>
        </div>

        <div class="form-field form-span-6">
          <%= f.input(
            :production_permission,
            collection: user.access_level,
            as: :select,
            include_blank: false
          ) %>
        </div>
      </div>
    </fieldset>
  <% end %>

  <div class="form-actions">
    <%= f.submit (@user.new_record? ? "Create" : "Update"), class: "button", name: nil %>
    <% unless @user.new_record? %>
      <%= link_to 'Delete', user_path(@user), class: "button alert",
                                data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' } %>
    <% end %>
  </div>
<% end %>
