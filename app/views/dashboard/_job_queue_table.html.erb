<div class="large-4 medium-6 small-12 columns end">
  <div class="job-queue-panel border">
    <div class="job-queue-panel-header">
      <h3>Job Queues</h3>
      <% online = active_solid_queue_workers.positive? %>
      <span class="job-queue-status <%= online ? 'job-queue-status--online' : 'job-queue-status--offline' %>">
        <i class="<%= online ? 'fi-check' : 'fi-alert' %>" aria-hidden="true"></i>
        <%= online ? pluralize(active_solid_queue_workers, "worker") + " online" : "Workers offline" %>
      </span>
    </div>

    <div class="job-queue-stats">
      <div class="job-queue-stat">
        <span>Processes</span>
        <strong><%= active_solid_queue_processes %></strong>
      </div>
      <div class="job-queue-stat">
        <span>Pending</span>
        <strong><%= pending_solid_queue_jobs %></strong>
      </div>
      <div class="job-queue-stat<%= ' job-queue-stat--alert' if failed_solid_queue_jobs.positive? %>">
        <span>Failed</span>
        <strong><%= failed_solid_queue_jobs %></strong>
      </div>
      <div class="job-queue-stat">
        <span>Completed</span>
        <strong><%= completed_solid_queue_jobs %></strong>
      </div>
    </div>

    <%= link_to "View Dashboard →", "/jobs", class: "button tiny job-queue-panel-action" %>
  </div>
</div>
