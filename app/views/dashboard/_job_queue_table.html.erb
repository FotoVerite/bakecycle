<div class="large-4 medium-6 small-12 columns end">
  <div class="stats border">
    <h3>Job Queues</h3>
    <table>
      <tbody>
        <tr>
          <td>Workers</td>
          <td><%= SolidQueue::Process.count %></td>
        </tr>
        <tr>
          <td>Pending</td>
          <td><%= SolidQueue::Job.where(finished_at: nil).count %></td>
        </tr>
        <tr>
          <td>Failed</td>
          <td><%= SolidQueue::FailedExecution.count %></td>
        </tr>
        <tr>
          <td>Completed</td>
          <td><%= SolidQueue::Job.where.not(finished_at: nil).count %></td>
        </tr>
      </tbody>
    </table>
    <%= link_to "View Dashboard →", "/jobs", class: "button tiny" %>
  </div>
</div>
