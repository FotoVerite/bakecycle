<div class="row">
  <div class="small-12 columns">
    <h2>Clients</h2>
  </div>
  <div class="large-4 medium-6 small-12 columns">
    <%= link_to(clients_path, class: "stats border") do %>
        <div class="left">
          Clients
          <h3><%= item_finder.clients.count %></h3>
        </div>
        <%= icon("users", class: "right") %>
    <% end %>
  </div>
  <div class="large-4 medium-6 small-12 columns">
    <%= link_to(orders_path, class: "stats border") do %>
        <div class="left">
          Orders
          <h3><%= item_finder.orders.count %></h3>
        </div>
        <%= icon("shopping-bag", class: "right") %>
    <% end %>
  </div>
  <div class="large-4 medium-6 small-12 columns">
    <%= link_to(shipments_path, class: "stats border") do %>
        <div class="left">
          Invoices
          <h3><%= item_finder.shipments.count %></h3>
        </div>
        <%= icon("files", class: "right") %>
    <% end %>
  </div>
</div>
