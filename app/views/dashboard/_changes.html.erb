<div class="row">
  <div class="small-12 columns">
    <h2>Changes</h2>
  </div>
  <div class="large-4 medium-6 small-12 columns">
    <%= link_to(created_at_orders_path, class: "stats border") do %>
        <div class="left">
          Orders Created Today
          <h3><%= item_finder.orders.created_at_date.count %></h3>
        </div>
        <%= icon("file-clock", class: "right") %>
    <% end %>
  </div>
  <div class="large-4 medium-6 small-12 columns">
    <%= link_to(updated_at_orders_path, class: "stats border") do %>
        <div class="left">
          Orders Updated Today
          <h3><%= 
                item_finder.orders.
                updated_at_date.
                where("end_date >= ? OR end_date is NULL", Date.today).
                count %></h3>
        </div>
        <%= icon("shopping-bag", class: "right") %>
    <% end %>
  </div>
  <div class="large-4 medium-6 small-12 columns">
    <%= link_to(file_actions_path, class: "stats border") do %>
        <div class="left">
          Files Accessed
        </div>
        <%= icon("shopping-bag", class: "right") %>
    <% end %>
  </div>
</div>

<div class="row">
  <div class="large-4 medium-6 small-12 columns">
    <%= link_to(created_at_recipes_path, class: "stats border") do %>
        <div class="left">
          Recipes Created Today
          <h3><%= item_finder.recipes.created_at_date.count %></h3>
        </div>
        <%= icon("clipboard-list", class: "right") %>
    <% end %>
  </div>
  <div class="large-4 medium-6 small-12 columns">
    <%= link_to(updated_at_recipes_path, class: "stats border") do %>
        <div class="left">
          Recipes Updated Today
          <h3><%= item_finder.recipes.updated_at_date.select {|r| r.versions.size > 1}.size %></h3>
        </div>
        <%= icon("clipboard-list", class: "right") %>
    <% end %>
  </div>
</div>

<div class="row">
  <div class="large-4 medium-6 small-12 columns">
    <%= link_to(created_at_products_path, class: "stats border") do %>
        <div class="left">
          Products Created Today
          <h3><%= item_finder.products.created_at_date.count %></h3>
        </div>
        <%= icon("package", class: "right") %>
    <% end %>
  </div>
  <div class="large-4 medium-6 small-12 columns">
    <%= link_to(updated_at_products_path, class: "stats border") do %>
        <div class="left">
          Products Updated Today
          <h3><%= item_finder.products.updated_at_date.select {|r| r.versions.size > 1}.size %></h3>
        </div>
        <%= icon("package", class: "right") %>
    <% end %>
  </div>
</div>
