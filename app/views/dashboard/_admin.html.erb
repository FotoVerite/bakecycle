<% if policy(:user).dashboard? || policy(:bakery).dashboard? || policy(:job).dashboard? %>
  <div class="row">
    <div class="small-12 columns">
      <h2>Admin</h2>
    </div>
    <% if policy(:user).dashboard? %>
      <div class="large-4 medium-6 small-12 columns end">
        <%= link_to(users_path, class: "stats border") do %>
            <div class="left">
              Users
              <h3><%= item_finder.users.count %></h3>
            </div>
            <%= icon("user", class: "right") %>
        <% end %>
      </div>
    <% end %>

    <% if policy(:bakery).dashboard? %>
      <div class="large-4 medium-6 small-12 columns end">
        <%= link_to(bakeries_path, class: "stats border") do %>
            <div class="left">
              Bakeries
              <h3><%= item_finder.bakeries.count %></h3>
            </div>
            <%= icon("users", class: "right") %>
        <% end %>
      </div>
    <% end %>

    <% if policy(:job).dashboard? %>
      <%= job_queue_table %>
    <% end %>
  </div>
<% end %>
