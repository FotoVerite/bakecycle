<section class="upcoming-invoices-panel">
  <div class="upcoming-invoices-header">
    <div>
      <h3>Upcoming Invoices</h3>
      <p>Scheduled invoices generated from this order.</p>
    </div>
    <span><%= pluralize(order.upcoming_shipments.size, "invoice") %></span>
  </div>

  <table class="responsive-table">
    <thead>
      <tr>
        <th scope="col">Invoice</th>
        <th scope="col">Date</th>
        <th scope="col">Client</th>
        <th scope="col">Action</th>
      </tr>
    </thead>
    <tbody>
      <% order.upcoming_shipments.each do |shipment| %>
        <tr class="js-clickable-row" href="<%= edit_shipment_path(shipment) %>">
          <th scope="row"><%= shipment.invoice_number %></th>
          <td data-title="Date"><%= shipment.date %></td>
          <td data-title="Client Name"><%= shipment.client_name %></td>
          <td data-title="Action">
            <%= action_icon edit_shipment_path(shipment), icon_name: "pencil", label: "Edit Shipment", variant: "edit" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
