<% provide(:title, "Papertrail of Order ##{@order.id}") %>
<div class="papertrail-page">
  <div class="index-header">
    <div>
      <h1>Papertrail of Order #<%= @order.id %></h1>
      <p class="papertrail-summary">
        <span><%= link_to @order.client_name, @order.client, class: "underlined-link" %></span>
        <% if @order.last_updated_by_user %>
          <span class="account-avatar"><%= @order.last_updated_by_user.name.first.upcase %></span>
          <span>
            Last edited by <strong><%= @order.last_updated_by_user.name %></strong>
            at <%= @order.updated_at.strftime("%b %-d, %Y · %-I:%M%P") %>
          </span>
        <% end %>
      </p>
    </div>
  </div>

  <div class="papertrail-section">
    <div class="papertrail-section-heading">
      <h2>Order Items</h2>
    </div>
    <% @order.all_order_items.includes(:product).order(:updated_at).each do |item| %>
      <div class="papertrail-group">
        <div class="papertrail-group-heading">
          <h3><%= item.product.name %></h3>
          <% if item.removed.to_i != 0 %>
            <span class="papertrail-removed-badge">Removed</span>
          <% end %>
        </div>
        <%= render partial: "shared/papertrail_timeline", locals: {
          versions: item.versions.includes(:item).reverse,
          only_fields: OrderItem::DAYS_OF_WEEK.map(&:to_s),
          empty_message: "No quantity changes recorded yet."
        } %>
      </div>
    <% end %>
  </div>
</div>
