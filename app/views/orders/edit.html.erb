<% provide(:title, "Editing Order ##{order.id}") %>

<div class="form-page order-form-page">
  <div class="form-header order-form-header">
    <div>
      <h1>Editing Order #<%= order.id %></h1>
      <p>
        <%= link_to order.client_name, order.client, class: "underlined-link" %>
        <span>Standing schedule and invoice settings.</span>
      </p>
    </div>

    <div class="form-header-actions order-action-bar">
      <%= link_to orders_path, class: "button small secondary" do %>
        <i class="fi-arrow-left"></i>
        <span>Back</span>
      <% end %>
      <%= link_to print_order_path(order), target: "_blank", class: "button small" do %>
        <i class="fi-print"></i>
        <span>Print</span>
      <% end %>
      <%= link_to copy_order_path(order), class: "button small" do %>
        <i class="fi-page-copy"></i>
        <span>Copy Order</span>
      <% end %>
      <%= link_to future_invoices_order_path(order), class: "button small order-action-primary" do %>
        <i class="fi-page-add"></i>
        <span>Create Future Invoices</span>
      <% end %>
    </div>
  </div>

  <% unless order.no_outstanding_shipments? %>
    <div class="overridable-orders panel callout radius">
      <h5>This order is missing invoices for <%= pluralize(order.missing_shipment_dates.size, 'date') %></h5>
      <ul><% for date in order.missing_shipment_dates %>
          <li><%= date %></li>
          <% end %>
      </ul>
      <%= link_to 'Create these invoices', add_invoices_order_path(@order),
            class: "button alert",
            data: { turbo_method: :put, turbo_confirm: "Production Run will need to be updated manually." } %>
    </div>
  <% end %>

  <%= render "form", order: order %>
  <%= render partial: 'upcoming_shipments' if order.upcoming_shipments.any? %>
</div>
