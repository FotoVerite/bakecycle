<% provide(:title, "Generate Grocery List for- #{@date.strftime('%A %b. %e, %Y')}") %>

<h1>Generate Grocery Lists for &mdash; <%= @date.strftime("%A %b. %e, %Y") %></h1>

<%= simple_form_for :future_invoices, url: print_grocery_list_orders_path, method: :get, :html => {:target => '_blank'} do |f| %>
  <div class="row collapse">
    <div class="small-12 medium-3 columns">
      <%= f.input :date, input_html: { value: @date.strftime("%Y-%m-%d"), class: "js-datepicker", name: :date}, required: false %>
    </div>
    <div class="small-12 medium-3 columns end">
      <%= f.submit 'Generate Grocery List', class: "button postfix search-button", name: nil %>
    </div>
  </div>
<% end %>

