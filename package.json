{
  "name": "bakecycle",
  "version": "1.0.0",
  "repository": "https://github.com/wizarddevelopment/bakecycle",
  "description": "Painless Bakery Operations",
  "homepage": "https://www.bakecycle.com",
  "engines": {
    "node": ">=18.x",
    "npm": ">=9.x"
  },
  "private": true,
  "scripts": {
    "build": "esbuild app/assets/javascripts/app.js --bundle --outfile=app/assets/builds/bakecycle.js --loader:.jsx=jsx --define:global=globalThis",
    "build:prod": "esbuild app/assets/javascripts/app.js --bundle --minify --outfile=app/assets/builds/bakecycle.js --loader:.jsx=jsx --define:global=globalThis",
    "build:watch": "esbuild app/assets/javascripts/app.js --bundle --outfile=app/assets/builds/bakecycle.js --loader:.jsx=jsx --define:global=globalThis --watch",
    "test": "jest",
    "test:coverage": "jest --coverage --collectCoverageFrom='app/assets/javascripts/{actions,reducers,constants}/**/*.{js,jsx}'"
  },
  "dependencies": {
    "classlist-polyfill": "^1.0.2",
    "core-js": "^2.4.0",
    "create-react-class": "^15.6.0",
    "date-fns": "^4.4.0",
    "google-map-react": "^2.2.5",
    "lodash.differenceby": "^4.6.0",
    "lodash.filter": "^4.6.0",
    "lodash.includes": "^4.3.0",
    "lodash.isfinite": "^3.3.1",
    "lodash.mapvalues": "^4.4.0",
    "lodash.pluck": "^3.1.2",
    "lodash.sortby": "^4.7.0",
    "lodash.uniq": "^4.5.0",
    "lodash.uniqueid": "^4.0.0",
    "lodash.without": "^4.2.0",
    "moment": "^2.24.0",
    "prop-types": "^15.5.10",
    "react": "^18.3.1",
    "react-datepicker": "^4.25.0",
    "react-dom": "^18.3.1",
    "react-redux": "^8.1.3",
    "react-select": "^1.0.0-beta13",
    "redux": "^4.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "babel-jest": "^30.4.1",
    "esbuild": "^0.25.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1"
  }
}
