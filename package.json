{
  "name": "bakecycle",
  "version": "1.0.0",
  "repository": "https://github.com/wizarddevelopment/bakecycle",
  "description": "Painless Bakery Operations",
  "homepage": "https://www.bakecycle.com",
  "engines": {
    "node": ">=18.x",
    "npm": ">=9.x"
  },
  "private": true,
  "scripts": {
    "build": "esbuild app/assets/javascripts/app.js --bundle --outfile=app/assets/builds/bakecycle.js --define:global=globalThis",
    "build:prod": "esbuild app/assets/javascripts/app.js --bundle --minify --outfile=app/assets/builds/bakecycle.js --define:global=globalThis",
    "build:watch": "esbuild app/assets/javascripts/app.js --bundle --outfile=app/assets/builds/bakecycle.js --define:global=globalThis --watch",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo": "^8.0.23",
    "@hotwired/turbo-rails": "^8.0.23",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-zone": "^2.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/instrumentation": "^0.220.0",
    "@opentelemetry/instrumentation-document-load": "^0.65.0",
    "@opentelemetry/instrumentation-fetch": "^0.220.0",
    "@opentelemetry/instrumentation-xml-http-request": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@opentelemetry/sdk-trace-web": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.42.0",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "classlist-polyfill": "^1.0.2",
    "core-js": "^2.4.0",
    "date-fns": "^4.4.0",
    "esbuild": "^0.25.0",
    "lucide-static": "^1.22.0",
    "sortablejs": "^1.15.7",
    "tom-select": "^2.6.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1"
  }
}
